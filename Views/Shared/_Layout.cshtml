                </div>
                <div class="nav-item dropdown">
                    <div class="text-wrapper">SẢN PHẨM <i class="fas fa-chevron-down"></i></div>
                    <div class="dropdown-menu">
                        <a href="/toocha/order/index" class="dropdown-item">TOOCHA TEA</a>
                        <a href="#" class="dropdown-item">INSTANT MILK TEA</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <div class="text-wrapper">THỰC ĐƠN <i class="fas fa-chevron-down"></i></div>
                    <div class="dropdown-menu">
                        <a href="/toocha/news/index" class="dropdown-item">TIN TỨC KHUYẾN MÃI</a>
                        <a href="/toocha/introduce/index" class="dropdown-item">CÂU CHUYỆN THƯƠNG HIỆU</a>
                        <a href="/toocha/event/index" class="dropdown-item">SỰ KIỆN</a>
                        <a href="/toocha/franchise/index" class="dropdown-item">NHƯỢNG QUYỀN TOOCHA</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <div class="text-wrapper">CỬA HÀNG <i class="fas fa-chevron-down"></i></div>
                    <div class="dropdown-menu">
                        <a href="/toocha/store/toochatea" class="dropdown-item">TOOCHA TEA</a>
                        <a href="#" class="dropdown-item">TOOCHA MILK AND COFFEE</a>
                    </div>
                </div>
                <div class="nav-item dropdown">
                    <div class="text-wrapper">TIN TỨC</div>
                </div>                
                <div class="nav-item dropdown">
                    <div class="text-wrapper">NHƯỢNG QUYỀN</div>
                </div>
            </div>
            <div class="nav-icons">
                <i class="fas fa-search"></i>
                <i class="fas fa-shopping-cart"></i>
                <i class="fas fa-bars"></i>
            </div>
        </nav>
    </header>

    @if (ViewData["HideBanner"] == null || (bool)ViewData["HideBanner"] == false)
    {
        <div class="banner mb-5">
            <img src="~/img/home/header.png" alt="Toocha Banner" class="banner-image">
        </div>
    }

    
            <main class="container-fluid">
                @RenderBody()
            </main>
                

