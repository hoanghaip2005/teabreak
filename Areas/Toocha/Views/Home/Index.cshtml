@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Trang Chủ";
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

<div class="best-seller-section">
    <div class="box">
        <div class="group">
            <p class="slogan">"Trà sữa đậm vị – Ăn vặt mê ly – Chill hết ý"</p>
            <div class="text">BEST SELLER</div>
            <div class="best-seller-title">
                <div class="lines-group-left">
                    <div class="line line-small"></div>
                    <div class="line line-large"></div>
                </div>
                <div class="star">
                    <i class="fas fa-star"></i>
                </div>
                <div class="lines-group-right">
                    <div class="line line-small"></div>
                    <div class="line line-large"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section-content container">
    <div class="list-product">
        @if (ViewBag.FeaturedProducts != null)
        {
            @foreach (var product in (List<App.Models.Toocha.Product>)ViewBag.FeaturedProducts)
            {
                <div class="product-card">
                    @if (product.SalePrice.HasValue)
                    {
                        <img class="image best-seller-badge" src="~/img/home/product_section/bestseller.png" />
                    }
                    <div class="tags">
                        @if (product.SalePrice.HasValue)
                        {
                            <span class="sale-tag">SALE</span>
                        }
                        @if (product.StockQuantity < 10)
                        {
                            <span class="low-stock-tag">Sắp hết</span>
                        }
                    </div>
                    <div class="img-wrap">
                        <img class="tra-sua-pho-mai" src="@(string.IsNullOrEmpty(product.Image) ? "~/img/no-image.png" : product.Image)" 
                             alt="@product.Name" 
                             onerror="this.src='~/img/no-image.png'" />
                    </div>
                    <div class="product-card-content">
                        <div class="text-wrapper" title="@product.Name">@product.Name</div>
                        <div class="text-wrapper-2">
                            @if (product.SalePrice.HasValue)
                            {
                                <span class="original-price">@product.Price.ToString("N0") VNĐ</span>
                                <span class="sale-price">@product.SalePrice.Value.ToString("N0") VNĐ</span>
                            }
                            else
                            {
                                <span>@product.Price.ToString("N0") VNĐ</span>
                            }
                        </div>
                        <div class="btn-type-one btn-order-product" data-product-id="@product.Id">Đặt hàng</div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="no-products-message">
                <p>Hiện tại chưa có sản phẩm nào. Vui lòng quay lại sau!</p>
            </div>
        }
        <div class="btn-type-one btn-view-all">Xem tất cả</div>
    </div>
</div>

<div class="img-ab-us container">
    <img class="img-about" src="~/img/home/about_us_new.png" alt="img-ab-us">
    <div class="home-about-us-content">
        <div class="section-title">
            <div class="text-1" bis_skin_checked="1">Toocha Story</div>
            <div class="text-2" bis_skin_checked="1">Về chúng tôi</div>
            <div class="icon-bottom-title" bis_skin_checked="1"></div>
