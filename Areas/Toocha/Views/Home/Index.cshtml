@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const header = document.querySelector('.header');
            let lastScrollTop = 0;
            let isScrolling;

            window.addEventListener('scroll', function () {
                let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                window.clearTimeout(isScrolling);

                if (scrollTop > 50) {
                    header.classList.add('header-scrolled');

                    if (scrollTop < lastScrollTop) {
                        header.classList.add('header-hidden');
                    } else {
                        header.classList.remove('header-hidden');
                    }
                } else {
                    header.classList.remove('header-scrolled');
                    header.classList.remove('header-hidden');
                }

                lastScrollTop = scrollTop;

                isScrolling = setTimeout(function () {
                    header.classList.remove('header-hidden');
                }, 150);
            });

            setTimeout(initializeStoreMap, 100);
            
            // Popup close functionality
            initializePopup();
        });

        function initializePopup() {
            const popup = document.querySelector('.home-popup');
            const closeBtn = document.querySelector('.home-popup .close-btn');
            const overlay = document.querySelector('.home-popup .overlay');
            
            if (!popup) return;
            
            // Show popup with animation on page load
            function showPopup() {
                popup.style.display = 'block';
                popup.classList.remove('hide');
            }
            
            function closePopup() {
                popup.classList.add('hide');
                // Completely hide after animation completes
                setTimeout(() => {
                    popup.style.display = 'none';
                }, 300);
            }
            
            // Show popup initially (after a small delay for better UX)
            setTimeout(showPopup, 1000);
            
            // Close popup when clicking close button
            if (closeBtn) {
                closeBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    closePopup();
                });
            }
            
            // Close popup when clicking overlay
            if (overlay) {
                overlay.addEventListener('click', function() {
                    closePopup();
                });
            }
            
            // Close popup with ESC key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && !popup.classList.contains('hide')) {
                    closePopup();
                }
            });
            
            // Prevent popup content clicks from closing popup
            const popupContent = document.querySelector('.home-popup .popup-content');
            if (popupContent) {
                popupContent.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            }
        }

        function checkStoresData() {
            fetch('/Toocha/Home/GetStoresData')
                .then(response => response.json())
                .then(data => {
                    alert(`Total stores: ${data.TotalStores}\nActive stores: ${data.ActiveStores}\nCheck console for details`);
                })
                .catch(error => {
                    alert('Error fetching stores data: ' + error.message);
                });
        }

        function initializeStoreMap() {
            const stores = @Html.Raw(Json.Serialize(ViewBag.Stores ?? new List<object>()));
            
            if (stores.length === 0) {
                document.getElementById('storeMap').innerHTML = '<div class="text-center text-muted py-5"><i class="fas fa-store fa-3x mb-3"></i><br>Chưa có cửa hàng nào</div>';
                return;
            }

            let centerLat = 16.0583;
            let centerLng = 108.2772;
            
            if (stores.length > 0) {
                const validStores = stores.filter((store, index) => {
                    const hasLat = store.latitude;
                    const hasLng = store.longitude;
                    const latNotNaN = !isNaN(store.latitude);
                    const lngNotNaN = !isNaN(store.longitude);
                    const latInRange = store.latitude >= -90 && store.latitude <= 90;
                    const lngInRange = store.longitude >= -180 && store.longitude <= 180;
                    const isValid = hasLat && hasLng && latNotNaN && lngNotNaN && latInRange && lngInRange;
                    return isValid;
                });
                
                if (validStores.length > 0) {
                    centerLat = validStores.reduce((sum, store) => sum + parseFloat(store.latitude), 0) / validStores.length;
                    centerLng = validStores.reduce((sum, store) => sum + parseFloat(store.longitude), 0) / validStores.length;
                }
            }

            if (typeof L === 'undefined') {
                document.getElementById('storeMap').innerHTML = '<div class="text-center text-danger py-5">Lỗi: Không thể tải bản đồ</div>';
                return;
            }
            
            let map;
            try {
                map = L.map('storeMap', { attributionControl: false, zoomControl: false }).setView([centerLat, centerLng], 6);
                
                L.tileLayer('https://mt1.google.com/vt/lyrs=m&x={x}&y={y}&z={z}', {
                    attribution: '© Google Maps',
                    maxZoom: 18
                }).addTo(map);
                
            } catch (error) {
                document.getElementById('storeMap').innerHTML = '<div class="text-center text-danger py-5">Lỗi khởi tạo bản đồ: ' + error.message + '</div>';
                return;
            }

            const northIcon = L.divIcon({
                html: '<i class="fas fa-map-marker-alt" style="color: #3498db; font-size: 28px;"></i>',
                iconSize: [35, 35],
                iconAnchor: [17, 35],
                popupAnchor: [0, -35],
                className: 'custom-marker-icon'
            });

            const southIcon = L.divIcon({
                html: '<i class="fas fa-map-marker-alt" style="color: #e74c3c; font-size: 28px;"></i>',
                iconSize: [35, 35],
                iconAnchor: [17, 35],
                popupAnchor: [0, -35],
                className: 'custom-marker-icon'
            });

            const defaultIcon = L.divIcon({
                html: '<i class="fas fa-map-marker-alt" style="color: #2ecc71; font-size: 28px;"></i>',
                iconSize: [35, 35],
                iconAnchor: [17, 35],
                popupAnchor: [0, -35],
                className: 'custom-marker-icon'
            });

            const validStoresForMarkers = stores.filter(store => 
                store.latitude && store.longitude && 
                !isNaN(store.latitude) && !isNaN(store.longitude) &&
                store.latitude >= -90 && store.latitude <= 90 &&
                store.longitude >= -180 && store.longitude <= 180
            );
            
            validStoresForMarkers.forEach((store, index) => {
                const lat = parseFloat(store.latitude);
                const lng = parseFloat(store.longitude);
                
                try {
                    let marker;
                    
                    let icon = defaultIcon;
                    if (store.region === 'MB') icon = northIcon;
                    else if (store.region === 'MN') icon = southIcon;
                    
                    try {
                        marker = L.marker([lat, lng], { 
                            icon: icon,
                            store: store
                        }).addTo(map);
                    } catch (iconError) {
                        marker = L.marker([lat, lng], {
                            store: store
                        }).addTo(map);
                    }

                    const popupContent = `
                        <div class="store-popup">
                            <h5 class="mb-2"><i class="fas fa-store me-2" style="color: #ff6b35;"></i>${store.name}</h5>
                            <p class="mb-2"><i class="fas fa-map-marker-alt me-2" style="color: #6c757d;"></i>${store.address}</p>
                            ${store.phoneNumber ? `<p class="mb-2"><i class="fas fa-phone me-2" style="color: #28a745;"></i>${store.phoneNumber}</p>` : ''}
                            ${store.openingHours ? `<p class="mb-3"><i class="fas fa-clock me-2" style="color: #ffc107;"></i>${store.openingHours}</p>` : ''}
                            <div class="text-center">
                                <a href="https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}" 
                                   class="btn btn-primary btn-sm px-3" 
                                   target="_blank">
                                    <i class="fas fa-directions me-1"></i>Chỉ đường
                                </a>
                            </div>
                        </div>
                    `;

                    marker.bindPopup(popupContent);

                    marker.on('mouseover', function() {
                        this.openPopup();
                    });
                    
                } catch (error) {
                    console.error(`Lỗi khi thêm marker cho ${store.name}:`, error);
                }
            });

            if (validStoresForMarkers.length > 0) {
                const markers = [];
                map.eachLayer(layer => {
                    if (layer instanceof L.Marker) {
                        markers.push(layer);
                    }
                });
                
                if (markers.length > 0) {
                    const group = L.featureGroup(markers);
                    map.fitBounds(group.getBounds().pad(0.1));
                }
            }

            function fitToRegion(regionCode) {
                console.log('Đang lọc khu vực:', regionCode);
                const regionMarkers = [];
                let regionName = '';
                let regionColor = '';

                switch(regionCode) {
                    case 'MB':
                        regionName = 'Miền Bắc';
                        regionColor = '#3498db';
                        break;
                    case 'MN':
                        regionName = 'Miền Nam';
                        regionColor = '#e74c3c';
                        break;
                    default:
                        regionName = 'Khu vực khác';
                        regionColor = '#2ecc71';
                }

                let totalMarkers = 0;
                let matchedMarkers = 0;

                map.eachLayer(layer => {
                    if (layer instanceof L.Marker) {
                        totalMarkers++;
                        const store = layer.options.store;
                        console.log('Kiểm tra store:', store ? `${store.name} (${store.region})` : 'Không có thông tin store');
                        
                        if (store && store.region === regionCode) {
                            matchedMarkers++;
                            regionMarkers.push(layer);
                            layer.setOpacity(1);
                        } else {
                            layer.setOpacity(0.3);
                        }
                    }
                });

                console.log(`Tổng số markers: ${totalMarkers}`);
                console.log(`Số markers phù hợp: ${matchedMarkers}`);

                if (regionMarkers.length > 0) {
                    console.log(`Tìm thấy ${regionMarkers.length} cửa hàng ở ${regionName}`);
                    const group = L.featureGroup(regionMarkers);
                    map.fitBounds(group.getBounds().pad(0.2));

                    L.popup()
                        .setLatLng(map.getCenter())
                        .setContent(`
                            <div style="text-align: center;">
                                <h5 style="color: ${regionColor}; margin-bottom: 10px;">
                                    <i class="fas fa-store me-2"></i>${regionName}
                                </h5>
                                <p style="margin: 0;">Số cửa hàng: ${regionMarkers.length}</p>
                            </div>
                        `)
                        .openOn(map);
                } else {
                    console.log(`Không tìm thấy cửa hàng nào ở ${regionName}`);
                    L.popup()
                        .setLatLng(map.getCenter())
                        .setContent(`
                            <div style="text-align: center;">
                                <h5 style="color: ${regionColor}; margin-bottom: 10px;">
                                    <i class="fas fa-store me-2"></i>${regionName}
                                </h5>
                                <p style="margin: 0;">Chưa có cửa hàng tại khu vực này</p>
                            </div>
                        `)
                        .openOn(map);
                }

                // Highlight nút được chọn
                ['mien-bac', 'mien-nam', 'khu-vuc-khac'].forEach(id => {
                    const btn = document.getElementById(id);
                    if (btn) {
                        btn.classList.remove('active');
                    }
                });
                
                let btnId;
                switch(regionCode) {
                    case 'MB': btnId = 'mien-bac'; break;
                    case 'MN': btnId = 'mien-nam'; break;
                    default: btnId = 'khu-vuc-khac';
                }
                const activeBtn = document.getElementById(btnId);
                if (activeBtn) {
                    activeBtn.classList.add('active');
                }
            }

            // Thêm nút reset view
            const resetViewBtn = document.createElement('button');
            resetViewBtn.innerHTML = '<i class="fas fa-sync-alt"></i>';
            resetViewBtn.title = 'Xem tất cả cửa hàng';
            resetViewBtn.style.cssText = 'position:absolute;top:16px;right:70px;z-index:1000;background:#fff;border:none;border-radius:50%;width:44px;height:44px;box-shadow:0 2px 8px rgba(0,0,0,0.15);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.3s ease;';
            document.querySelector('.map-container').appendChild(resetViewBtn);

            resetViewBtn.onclick = function() {
                // Reset marker opacity
                map.eachLayer(layer => {
                    if (layer instanceof L.Marker) {
                        layer.setOpacity(1);
                    }
                });

                // Reset active state của các nút
                ['mien-bac', 'mien-nam', 'khu-vuc-khac'].forEach(id => {
                    const btn = document.getElementById(id);
                    if (btn) {
                        btn.classList.remove('active');
                    }
                });

                // Fit bounds to all markers
                const allMarkers = [];
                map.eachLayer(layer => {
                    if (layer instanceof L.Marker) {
                        allMarkers.push(layer);
                    }
                });

                if (allMarkers.length > 0) {
                    const group = L.featureGroup(allMarkers);
                    map.fitBounds(group.getBounds().pad(0.2));
                }

                // Đóng popup nếu đang mở
                map.closePopup();
            };

            // Cập nhật sự kiện click cho các nút khu vực
            document.getElementById('mien-bac').onclick = function() { fitToRegion('MB'); };
            document.getElementById('mien-nam').onclick = function() { fitToRegion('MN'); };
            document.getElementById('khu-vuc-khac').onclick = function() { fitToRegion('OTHER'); };

            // Thêm style cho các nút
            const style = document.createElement('style');
            style.textContent = `
                .legend-item {
                    transition: all 0.3s ease;
                }
                .legend-item:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 15px rgba(0,0,0,0.15);
                }
                .legend-item.active {
                    background: #fff5f5;
                    border-color: currentColor;
                }
                #resetViewBtn:hover {
                    transform: rotate(180deg);
                }
            `;
            document.head.appendChild(style);

            let userMarker = null;
            document.getElementById('locateMeBtn').onclick = async function() {
                // Kiểm tra môi trường và hiển thị thông tin chẩn đoán
                const diagnostics = [];
                diagnostics.push(`Secure Context: ${window.isSecureContext}`);
                diagnostics.push(`Protocol: ${window.location.protocol}`);
                diagnostics.push(`Host: ${window.location.host}`);
                console.log('Diagnostics:', diagnostics.join(', '));

                if (!window.isSecureContext) {
                    const errorMsg = `
                        <div style="color:#721c24;background-color:#f8d7da;padding:10px;border-radius:4px;margin-bottom:10px;">
                            <b>Lỗi bảo mật:</b> Tính năng định vị yêu cầu kết nối an toàn (HTTPS)
                        </div>
                        <div style="margin-top:10px;">
                            <b>Cách khắc phục:</b><br>
                            1. Chạy ứng dụng bằng HTTPS<br>
                            2. Hoặc sử dụng một trong các địa chỉ sau:<br>
                            - https://localhost:5001<br>
                            - https://localhost:44321<br>
                            3. Hoặc thêm chứng chỉ SSL cho domain
                        </div>
                        <div style="margin-top:10px;font-size:0.9em;color:#666;">
                            Chi tiết: ${diagnostics.join('<br>')}
                        </div>`;
                    L.popup({maxWidth: 300})
                        .setLatLng(map.getCenter())
                        .setContent(errorMsg)
                        .openOn(map);
                    return;
                }

                if (!navigator.geolocation) {
                    L.popup()
                        .setLatLng(map.getCenter())
                        .setContent('Trình duyệt của bạn không hỗ trợ định vị.')
                        .openOn(map);
                    return;
                }

                const btn = document.getElementById('locateMeBtn');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin" style="font-size:22px;color:#ff6b35;"></i>';
                btn.disabled = true;

                try {
                    const position = await new Promise((resolve, reject) => {
                        const watchId = navigator.geolocation.watchPosition(
                            (pos) => {
                                navigator.geolocation.clearWatch(watchId);
                                resolve(pos);
                            },
                            (err) => {
                                navigator.geolocation.clearWatch(watchId);
                                reject(err);
                            },
                            {
                                enableHighAccuracy: false,
                                timeout: 10000,
                                maximumAge: 60000
                            }
                        );

                        // Backup timeout
                        setTimeout(() => {
                            navigator.geolocation.clearWatch(watchId);
                            reject({
                                code: 3,
                                message: 'Timeout'
                            });
                        }, 12000);
                    });

                    const lat = position.coords.latitude;
                    const lng = position.coords.longitude;

                    if (userMarker) map.removeLayer(userMarker);
                    userMarker = L.marker([lat, lng], {
                        icon: L.divIcon({
                            html: '<i class="fas fa-street-view" style="color:#ff6b35;font-size:28px;"></i>',
                            iconSize: [35, 35],
                            iconAnchor: [17, 35],
                            popupAnchor: [0, -35],
                            className: 'custom-marker-icon'
                        })
                    }).addTo(map).bindPopup('Vị trí của bạn').openPopup();
                    map.setView([lat, lng], 14);

                    btn.style.background = '#d4edda';
                    setTimeout(() => { btn.style.background = '#fff'; }, 2000);

                } catch (err) {
                    let errorMsg = '<div style="color:#721c24;background-color:#f8d7da;padding:10px;border-radius:4px;">';
                    switch (err.code) {
                        case 1:
                            errorMsg += `
                                <b>Quyền truy cập bị từ chối</b><br><br>
                                <b>Cách khắc phục:</b><br>
                                1. Mở cài đặt trình duyệt:<br>
                                - Chrome: chrome://settings/content/location<br>
                                - Edge: edge://settings/content/location<br>
                                - Firefox: about:preferences#privacy<br>
                                2. Tìm website này trong danh sách chặn và xóa<br>
                                3. Cho phép truy cập vị trí cho website<br>
                                4. Tải lại trang và thử lại
                            `;
                            break;
                        case 2:
                            errorMsg += `
                                <b>Không thể xác định vị trí</b><br><br>
                                <b>Vui lòng kiểm tra:</b><br>
                                1. GPS đã được bật<br>
                                2. Kết nối mạng ổn định<br>
                                3. Không sử dụng VPN<br>
                                4. Cho phép vị trí trong Windows/MacOS
                            `;
                            break;
                        case 3:
                            errorMsg += `
                                <b>Quá thời gian yêu cầu</b><br><br>
                                <b>Nguyên nhân có thể:</b><br>
                                1. Kết nối mạng chậm<br>
                                2. GPS khởi động chậm<br>
                                3. Nhiều ứng dụng đang sử dụng GPS<br><br>
                                Vui lòng thử lại sau vài giây.
                            `;
                            break;
                        default:
                            errorMsg += `<b>Lỗi không xác định:</b> ${err.message}`;
                    }
                    errorMsg += '</div>';
                    
                    map.setView([16.0583, 108.2772], 6);
                    L.popup({maxWidth: 300})
                        .setLatLng([16.0583, 108.2772])
                        .setContent(errorMsg)
                        .openOn(map);
                        
                    btn.style.background = '#f8d7da';
                    setTimeout(() => { btn.style.background = '#fff'; }, 2000);
                } finally {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            };
        }
    </script>

