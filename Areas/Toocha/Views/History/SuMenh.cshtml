@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sứ Mệnh Toocha";
    ViewData["HideBanner"] = true;
}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Be Vietnam Pro', sans-serif;
        line-height: 1.6;
        color: #333;
    }

        .container-fluid {
        padding: 0;
    }

    .mission-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    /* Hero Section */
    .hero-section {
        background: linear-gradient(135deg, #8B4513 0%, #D2691E 50%, #CD853F 100%);
        color: white;
        padding: 100px 0 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="mission-pattern" x="0" y="0" width="30" height="30" patternUnits="userSpaceOnUse"><circle cx="15" cy="15" r="1.5" fill="rgba(255,255,255,0.1)"/><circle cx="5" cy="25" r="1" fill="rgba(255,255,255,0.05)"/><circle cx="25" cy="5" r="1" fill="rgba(255,255,255,0.05)"/></pattern></defs><rect width="100" height="100" fill="url(%23mission-pattern)"/></svg>');
        opacity: 0.4;
    }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-title {
        font-size: 3.8rem;
        font-weight: 900;
        margin-bottom: 25px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        letter-spacing: 2px;
    }

    .hero-subtitle {
        font-size: 1.4rem;
        font-weight: 400;
        max-width: 700px;
        margin: 0 auto;
        opacity: 0.95;
        line-height: 1.8;
    }

    /* Core Mission Section */
    .core-mission-section {
        padding: 100px 0;
        background: linear-gradient(45deg, #FFF8DC 0%, #F5DEB3 100%);
        text-align: center;
        position: relative;
    }

    .core-mission-box {
        background: white;
        padding: 60px 50px;
        border-radius: 20px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.1);
        position: relative;
        max-width: 900px;
        margin: 0 auto;
        border: 3px solid #8B4513;
    }

    .core-mission-box::before {
        content: '';
        position: absolute;
        top: -3px;
        left: -3px;
        right: -3px;
        bottom: -3px;
        background: linear-gradient(45deg, #8B4513, #D2691E, #CD853F);
        border-radius: 20px;
        z-index: -1;
        animation: gradient-border 3s ease infinite;
    }

    @@keyframes gradient-border {
        0%, 100% { background: linear-gradient(45deg, #8B4513, #D2691E, #CD853F); }
        50% { background: linear-gradient(45deg, #D2691E, #CD853F, #8B4513); }
    }

    .core-mission-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #654321;
        margin-bottom: 40px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .core-mission-text {
        font-size: 1.3rem;
        line-height: 1.9;
        color: #8B4513;
        font-weight: 500;
        font-style: italic;
        text-align: justify;
    }

    /* Pillars Section */
    .pillars-section {
        padding: 100px 0;
        background: white;
    }

    .pillars-title {
        font-size: 2.8rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 80px;
        color: #654321;
        position: relative;
    }

    .pillars-title::after {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #8B4513, #D2691E);
        border-radius: 2px;
    }

    .pillar-item {
        margin-bottom: 80px;
        background: #FAEBD7;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    .pillar-item:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.1);
    }

    .pillar-header {
        background: linear-gradient(135deg, #8B4513 0%, #D2691E 100%);
        color: white;
        padding: 40px;
        text-align: center;
        position: relative;
    }

    .pillar-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        display: block;
    }

    .pillar-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .pillar-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
        font-style: italic;
    }

    .pillar-content {
        padding: 50px 40px;
    }

    .pillar-description {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #495057;
        margin-bottom: 30px;
        text-align: justify;
    }

    .pillar-features {
        list-style: none;
        padding: 0;
    }

    .pillar-features li {
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
        position: relative;
        padding-left: 40px;
    }

    .pillar-features li:last-child {
        border-bottom: none;
    }

    .pillar-features li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 20px;
        height: 20px;
        background: linear-gradient(45deg, #8B4513, #D2691E);
        border-radius: 50%;
    }

    .feature-title {
        font-weight: 600;
        color: #654321;
        margin-bottom: 5px;
    }

    .feature-description {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    /* Conclusion Section */
    .conclusion-section {
        background: linear-gradient(135deg, #654321 0%, #8B4513 100%);
        color: white;
        padding: 80px 0;
        text-align: center;
    }

    .conclusion-text {
        font-size: 1.3rem;
        line-height: 1.9;
        max-width: 800px;
        margin: 0 auto;
        font-weight: 400;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .hero-title {
            font-size: 2.8rem;
        }

        .hero-subtitle {
            font-size: 1.2rem;
        }

        .core-mission-box {
            padding: 40px 30px;
        }

        .core-mission-text {
            font-size: 1.1rem;
        }

        .pillars-title {
            font-size: 2.2rem;
        }

        .pillar-content {
            padding: 30px 25px;
        }

        .pillar-header {
            padding: 30px 25px;
        }

        .pillar-icon {
            font-size: 2.5rem;
        }
    }

    @@media (max-width: 480px) {
        .mission-container {
            padding: 0 15px;
        }

        .hero-title {
            font-size: 2.2rem;
        }

        .core-mission-box {
            padding: 30px 20px;
        }

        .pillars-section {
            padding: 60px 0;
        }

        .pillar-item {
            margin-bottom: 60px;
        }
    }

    /* Animation */
    .fade-in {
        opacity: 0;
        transform: translateY(30px);
        transition: all 0.8s ease;
    }

    .fade-in.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .slide-in-left {
        opacity: 0;
        transform: translateX(-50px);
        transition: all 0.8s ease;
    }

    .slide-in-left.visible {
        opacity: 1;
        transform: translateX(0);
    }

    .slide-in-right {
        opacity: 0;
        transform: translateX(50px);
        transition: all 0.8s ease;
    }

    .slide-in-right.visible {
        opacity: 1;
        transform: translateX(0);
    }
</style>

<main>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="mission-container">
            <div class="hero-content fade-in">
                <h1 class="hero-title">SỨ MỆNH CỦA TOOCHA</h1>
                <p class="hero-subtitle">
                    Không chỉ tạo ra những ly trà ngon, chúng tôi kiến tạo những trải nghiệm đáng nhớ.
                </p>
            </div>
        </div>
    </section>

    <!-- Core Mission Section -->
    <section class="core-mission-section">
        <div class="mission-container">
            <div class="core-mission-box fade-in">
                <h2 class="core-mission-title">Sứ Mệnh Cốt Lõi</h2>
                <p class="core-mission-text">
                    "Sứ mệnh của Toocha là nâng tầm trải nghiệm thưởng thức trà, trở thành cầu nối văn hóa trà sữa Đài Loan đích thực đến với khách hàng Việt Nam thông qua những sản phẩm được tạo tác từ sự Tận Tâm, Nguyên Bản và Sáng Tạo."
                </p>
            </div>
        </div>
    </section>

    <!-- Pillars Section -->
    <section class="pillars-section">
        <div class="mission-container">
            <h2 class="pillars-title fade-in">Những Trụ Cột Chính Để Thực Hiện Sứ Mệnh</h2>

            <!-- Pillar 1: Quality -->
            <div class="pillar-item slide-in-left">
                <div class="pillar-header">
                    <i class="fas fa-leaf pillar-icon"></i>
                    <h3 class="pillar-title">Tôn Vinh Giá Trị Nguyên Bản</h3>
                    <p class="pillar-subtitle">Commitment to Quality</p>
                </div>
                <div class="pillar-content">
                    <p class="pillar-description">
                        Chúng tôi đặt chất lượng làm nền tảng cho mọi hoạt động. Sứ mệnh của Toocha là mang đến những ly trà giữ trọn vẹn hương vị tinh túy nhất bằng cách:
                    </p>
                    <ul class="pillar-features">
                        <li>
                            <div class="feature-title">100% Trà Tươi</div>
                            <div class="feature-description">Luôn sử dụng trà được ủ mới trong ngày.</div>
                        </li>
                        <li>
                            <div class="feature-title">Nguyên Liệu Tự Nhiên</div>
                            <div class="feature-description">Tuyển chọn nguyên liệu an toàn, có nguồn gốc rõ ràng, nói không với hương liệu nhân tạo.</div>
                        </li>
                        <li>
                            <div class="feature-title">Quy Trình Chuẩn Mực</div>
                            <div class="feature-description">Duy trì tiêu chuẩn nghiêm ngặt trong từng khâu, từ bảo quản đến pha chế.</div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Pillar 2: Customer Experience -->
            <div class="pillar-item slide-in-right">
                <div class="pillar-header">
                    <i class="fas fa-heart pillar-icon"></i>
                    <h3 class="pillar-title">Kiến Tạo Trải Nghiệm Khách Hàng</h3>
                    <p class="pillar-subtitle">Customer Experience First</p>
                </div>
                <div class="pillar-content">
                    <p class="pillar-description">
                        Một ly trà ngon phải đi cùng một trải nghiệm tuyệt vời. Chúng tôi theo đuổi sứ mệnh mang lại niềm vui cho khách hàng qua:
                    </p>
                    <ul class="pillar-features">
                        <li>
                            <div class="feature-title">Dịch Vụ Tận Tâm</div>
                            <div class="feature-description">Mỗi nhân viên là một đại sứ thương hiệu, phục vụ bằng sự nhiệt thành và chu đáo.</div>
                        </li>
                        <li>
                            <div class="feature-title">Không Gian Thân Thiện</div>
                            <div class="feature-description">Xây dựng một không gian sạch sẽ, thoải mái để bạn có thể tận hưởng trọn vẹn khoảnh khắc thư giãn.</div>
                        </li>
                        <li>
                            <div class="feature-title">Lắng Nghe & Thấu Hiểu</div>
                            <div class="feature-description">Luôn trân trọng mọi phản hồi để không ngừng cải thiện và làm hài lòng khách hàng.</div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Pillar 3: Innovation -->
            <div class="pillar-item slide-in-left">
                <div class="pillar-header">
                    <i class="fas fa-lightbulb pillar-icon"></i>
                    <h3 class="pillar-title">Lan Tỏa Đam Mê Sáng Tạo</h3>
                    <p class="pillar-subtitle">Passion for Innovation</p>
                </div>
                <div class="pillar-content">
                    <p class="pillar-description">
                        Tôn trọng truyền thống không có nghĩa là ngừng đổi mới. Sứ mệnh của chúng tôi là liên tục sáng tạo để mang đến sự bất ngờ thú vị:
                    </p>
                    <ul class="pillar-features">
                        <li>
                            <div class="feature-title">Phát Triển Sản Phẩm Mới</div>
                            <div class="feature-description">Không ngừng nghiên cứu và cho ra mắt những công thức độc đáo, bắt kịp xu hướng toàn cầu nhưng vẫn giữ bản sắc riêng.</div>
                        </li>
                        <li>
                            <div class="feature-title">Cá Nhân Hóa Trải Nghiệm</div>
                            <div class="feature-description">Cung cấp nhiều lựa chọn (topping, mức đường, đá) để bạn tự tay "tô vẽ" nên ly trà hợp khẩu vị nhất.</div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Conclusion Section -->
    <section class="conclusion-section">
        <div class="mission-container">
            <p class="conclusion-text fade-in">
                Tại Toocha, mỗi ly trà được trao đi không chỉ là một sản phẩm, mà còn là hiện thân cho sứ mệnh mà chúng tôi luôn theo đuổi. Cảm ơn bạn đã là một phần trong hành trình này.
            </p>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Animation on scroll
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, observerOptions);

            // Observe all animation elements
            document.querySelectorAll('.fade-in, .slide-in-left, .slide-in-right').forEach(el => {
                observer.observe(el);
            });

            // Header scroll behavior
            const header = document.querySelector('.header');
            let lastScrollTop = 0;
            let isScrolling;

            window.addEventListener('scroll', function() {
                let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

                window.clearTimeout(isScrolling);

                if (scrollTop > 50) {
                    header?.classList.add('header-scrolled');

                    if (scrollTop < lastScrollTop) {
                        header?.classList.add('header-hidden');
                    } else {
                        header?.classList.remove('header-hidden');
                    }
                } else {
                    header?.classList.remove('header-scrolled');
                    header?.classList.remove('header-hidden');
                }

                lastScrollTop = scrollTop;

                isScrolling = setTimeout(function() {
                    header?.classList.remove('header-hidden');
                }, 150);
            });
        });
    </script>
} 