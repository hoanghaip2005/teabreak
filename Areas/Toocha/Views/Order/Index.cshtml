@model IEnumerable<toocha.Models.Toocha.Category>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - toocha</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/Areas/Toocha/assets/css/order.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css" />
    <script src="https://kit.fontawesome.com/5ca428eb12.js" crossorigin="anonymous"></script>
</head>
<body>
    @Html.AntiForgeryToken()
    <header class="header">
        <a class="logo">
            TOOCHA TEA
        </a>
        <div class="search">
            <input class="input-search" type="text" placeholder="Tìm kiếm sản phẩm..." value="">
            <select id="region-selector" style="margin-left: 10px; padding: 5px; border-radius: 99px; border-color: #00000042;">
                <option value="0">Tất cả</option>
                <option value="mien-bac">Miền Bắc</option>
                <option value="mien-nam">Miền Nam</option>
            </select>
        </div>
        <div class="right" bis_skin_checked="1">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="user-avatar-container">
                    <div class="user-avatar" onclick="toggleUserMenu()">
                        <div class="avatar-placeholder">
                            <i class="fas fa-user"></i>
                        </div>
                        <span class="user-name">@User.Identity.Name</span>
                        <i class="fas fa-chevron-down"></i>
                    </div>
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-item">
                            <i class="fas fa-user mr-2"></i>
                            Thông tin cá nhân
                        </div>
                        <div class="dropdown-item">
                            <i class="fas fa-shopping-bag mr-2"></i>
                            Lịch sử đơn hàng
                        </div>
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-item" onclick="logout()">
                            <i class="fas fa-sign-out-alt mr-2"></i>
                            Đăng xuất
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a href="/login/" class="login-button" style="text-decoration: none;">Đăng nhập</a>
            }
        </div>
    </header>
    
    <div class="page-order" style="background: #fbfbfb !important;" bis_skin_checked="1">
        <div class="order-content" bis_skin_checked="1">
            <div class="order-sidebar sidebar-left" bis_skin_checked="1">
                <div class="cat-title" bis_skin_checked="1">Danh mục</div>
                <div class="list-cat" bis_skin_checked="1">
                    @foreach (var category in Model)
                    {
                        <div class="cat-item" catslug="category-@category.Id" bis_skin_checked="1">
                            <div class="cat-name" bis_skin_checked="1">@category.Name</div>
                            <div class="cat-amount" bis_skin_checked="1">@category.Products.Count(p => p.IsPublished)</div>
                        </div>
                    }
                </div>
            </div>

            <div class="order-center" bis_skin_checked="1">
                <div class="mobile-banner" bis_skin_checked="1"></div>
                <div class="main-center" bis_skin_checked="1">
                    @* Popup chọn vùng miền *@
                    <div id="region-popup" style="
                        display: none; 
                        position: fixed; 
                        top: 0; left: 0; 
                        width: 100%; height: 100%;
                        background: rgba(0,0,0,0.5); 
                        z-index: 9999; 
                        justify-content: center; 
                        align-items: center;
                    " bis_skin_checked="1">
                        <div style="background: white; padding: 20px; border-radius: 10px; text-align: center;" bis_skin_checked="1">
                            <h3>Bạn đang ở khu vực nào?</h3>
                            <button onclick="setRegion('mien-bac')" style="margin: 10px;border-radius: 99px; padding: 5px 20px; border-color: #00000061;">Miền Bắc</button>
                            <button onclick="setRegion('mien-nam')" style="margin: 10px;border-radius: 99px; padding: 5px 20px; border-color: #00000061;">Miền Nam</button>
                        </div>
                    </div>

                    @foreach (var category in Model)
                    {
                        <div class="category" catslug="category-@category.Id" bis_skin_checked="1">
                            <div class="category-name" bis_skin_checked="1">
                                <div class="left" bis_skin_checked="1">@category.Name</div>
                                <div class="right" bis_skin_checked="1">
                                    <i class="fas fa-angle-down"></i>
                                </div>
                            </div>
                            <div class="list-product" bis_skin_checked="1">
                                @foreach (var product in category.Products.Where(p => p.IsPublished))
                                {
                                    <div class="product" product_id="@product.Id" default_variation_id="@product.Id" bis_skin_checked="1">
                                        <img src="@(string.IsNullOrEmpty(product.Image) ? "/images/default-product.png" : product.Image)" alt="@product.Name">
                                        <div class="product-name" bis_skin_checked="1">@product.Name</div>
                                        <div class="product-price" bis_skin_checked="1">
                                            <p class="product-origin-price">@product.Price.ToString("N0")đ</p>
                                            @if (product.SalePrice.HasValue)
                                            {
                                                <p class="product-sale-price">@product.SalePrice.Value.ToString("N0")đ</p>
                                            }
                                        </div>
                                        <div class="btn-increase btn-order-popup" data-id="@product.Id">+</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            
            <div class="order-sidebar sidebar-right" bis_skin_checked="1">
                <div class="cart-group-top" bis_skin_checked="1">
                    <div class="cart-title" bis_skin_checked="1">
                        <div class="arrow-down" bis_skin_checked="1">
                            <i class="fas fa-arrow-down"></i>
                        </div>
                        <div class="cart-title-left" bis_skin_checked="1"> Giỏ hàng của tôi </div>
                        <div class="cart-title-right" id="clear-cart" bis_skin_checked="1"> Xóa tất cả </div>
                    </div>
                    <div class="cart-ss1" bis_skin_checked="1">Chưa có sản phẩm nào!</div>
                </div>
                <div class="cart-group-bottom" bis_skin_checked="1">
                    <div class="cart-ss2" bis_skin_checked="1">
                        <img class="img-toco" src="https://tocotocotea.com/wp-content/themes/tocotocotea/assets/images/icon-glass-tea.png" alt="">
                        <span class="cart-ss2-one">x</span>
                        <span class="cart-ss2-two">0</span>
                        <span class="cart-ss2-three">=</span>
                        <span class="cart-ss2-four">0đ</span>
                    </div>
                    <div class="cart-ss3" bis_skin_checked="1">
                        <div class="button-cart" bis_skin_checked="1">Thanh toán</div>
                    </div>
                </div>
            </div>
            <div class="btn-menu" bis_skin_checked="1">
                <i class="fas fa-bars"></i>
                <i class="fas fa-times"></i>
            </div>
        </div>
    </div>

    <!-- Modal sản phẩm với animation đẹp -->
    <div class="modal fade" id="productModal" tabindex="-1" role="dialog" aria-labelledby="productModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content modern-modal">
                <div class="modal-body modern-body">
                    <div class="row">
                            <div class="product-image-container">
                                <img id="modalProductImage" src="" class="product-image" alt="Product Image">
                                <div class="product-info">
                                    <h2 id="modalProductName" class="product-title">Tên sản phẩm</h2>
                                    <p id="modalProductDescription" class="product-description">Mô tả sản phẩm.</p>
                                        <div class="quantity-controls">
                                            <button class="quantity-btn" id="btn-decrease">
                                                <i class="fas fa-minus"></i>
                                            </button>
                                            <input type="number" id="quantityInput" class="quantity-input" value="1" min="1">
                                            <button class="quantity-btn" id="btn-increase">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                            <div class="price-container">
                                                <span class="price-label">Giá:</span>
                                                <span id="modalProductPrice" class="price-value">0</span>đ
                                            </div>
                                        </div>
                                    <div class="modern-footer">
                                        <div class="total-section">
                                            <span class="total-label">Tổng cộng:</span>
                                            <span id="modalTotalPrice" class="total-price">0đ</span>
                                        </div>
                                        <button type="button" class="btn btn-add-cart" id="btn-add-to-cart">
                                            <i class="fas fa-shopping-cart mr-2"></i>
                                            Thêm vào giỏ hàng
                                        </button>
                                    </div>
                                </div>
                            </div>
                    </div>

                    <div class="options-section">
                        <div class="options-container">
                            <!-- Size Selection -->
                            <div class="option-card">
                                <div class="option-header">
                                    <i class="fas fa-expand-arrows-alt"></i>
                                    <h6>Kích thước</h6>
                                </div>
                                <div id="sizeOptionsContainer" class="size-options"></div>
                            </div>
                            
                            <!-- Sugar & Ice Selection -->
                            <div class="option-card">
                                <div class="option-header">
                                    <i class="fas fa-sliders-h"></i>
                                    <h6>Tùy chỉnh</h6>
                                </div>
                                <div class="customize-row">
                                    <div class="customize-item">
                                        <label>Đường</label>
                                        <select class="custom-select" id="sugarRange">
                                            <option value="100">🍯 100%</option>
                                            <option value="70">🍯 70%</option>
                                            <option value="50" selected>🍯 50%</option>
                                            <option value="30">🍯 30%</option>
                                            <option value="0">❌ 0%</option>
                                        </select>
                                    </div>
                                    <div class="customize-item">
                                        <label>Đá</label>
                                        <select class="custom-select" id="iceRange">
                                            <option value="100" selected>🧊 100%</option>
                                            <option value="70">🧊 70%</option>
                                            <option value="50">🧊 50%</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Topping Selection -->
                            <div class="option-card">
                                <div class="option-header">
                                    <i class="fas fa-plus-circle"></i>
                                    <h6>Topping thêm</h6>
                                </div>
                                <div id="toppingOptionsContainer" class="topping-grid"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thanh toán -->
    <div class="modal fade" id="checkoutModal" tabindex="-1" role="dialog" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content checkout-modal">
                <div class="modal-header checkout-header">
                    <h4 class="modal-title" id="checkoutModalLabel">
                        <i class="fas fa-shopping-cart mr-2"></i>
                        Thanh toán đơn hàng
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="modal-body checkout-body">
                    <div class="row">
                        <div class="col-md-7">
                            <div class="customer-info-section">
                                <h5 class="section-title">
                                    <i class="fas fa-user mr-2"></i>
                                    Thông tin khách hàng
                                </h5>
                                <form id="checkoutForm">
                                    <div class="customer-row">
                                        <div class="customer-name">
                                            <label for="customerName">Họ và tên *</label>
                                            <input type="text" class="form-control" id="customerName" required>
                                        </div>
                                        <div class="customer-phone">
                                            <label for="customerPhone">Số điện thoại *</label>
                                            <input type="tel" class="form-control" id="customerPhone" required>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="customerEmail">Email (tùy chọn)</label>
                                        <input type="email" class="form-control" id="customerEmail" placeholder="Để nhận thông báo đơn hàng">
                                    </div>
                                    <div class="form-group">
                                        <label for="customerAddress">Địa chỉ giao hàng *</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" id="customerAddress" required 
                                                   placeholder="Nhập địa chỉ chi tiết để tìm cửa hàng gần nhất...">
                                            <div class="input-group-append">
                                                <button type="button" class="btn btn-outline-primary btn-find-stores" id="btnFindStores">
                                                    <i class="fas fa-search-location"></i>
                                                    <span class="d-none d-lg-inline ml-1">Tìm cửa hàng</span>
                                                </button>
                                            </div>
                                        </div>
                                        <small class="form-text text-muted">
                                            <i class="fas fa-info-circle"></i> 
                                            Phạm vi giao hàng: <strong>Tối đa 35km</strong> từ cửa hàng gần nhất
                                        </small>
                                    </div>
                                    
                                    <!-- Store Selection -->
                                    <div class="form-group" id="storeSelectionGroup" style="display: none;">
                                        <label>Chọn cửa hàng giao hàng:</label>
                                        <div class="store-selector-container" style="position: relative;">
                                            <button type="button" class="btn btn-outline-primary btn-store-selector" id="btnStoreSelector">
                                                <i class="fas fa-store mr-2"></i>
                                                <span id="selectedStoreName">Chọn cửa hàng gần nhất</span>
                                                <i class="fas fa-chevron-down ml-auto"></i>
                                            </button>
                                            <div id="storeDropdown" class="store-dropdown" style="display: none;">
                                                <div class="store-dropdown-header">
                                                    <i class="fas fa-map-marker-alt mr-2"></i>
                                                    Cửa hàng gần bạn
                                                </div>
                                                <div id="storesList" class="stores-list">
                                                    <!-- Stores will be loaded here -->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label for="orderNote">Ghi chú (tùy chọn)</label>
                                        <input type="text" class="form-control" id="orderNote" placeholder="Ghi chú thêm cho đơn hàng...">
                                    </div>
                                </form>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="order-summary-section">
                                <h5 class="section-title">
                                    <i class="fas fa-receipt mr-2"></i>
                                    Chi tiết đơn hàng
                                </h5>
                                <div class="cart-items-list" id="checkoutCartItems">
                                    <!-- Cart items sẽ được load bằng JavaScript -->
                                </div>
                                <div class="order-total-section">
                                    <div class="total-row">
                                        <span>Tạm tính:</span>
                                        <span id="checkoutSubtotal">0đ</span>
                                    </div>
                                    <div class="total-row shipping-row">
                                        <span>Phí giao hàng:</span>
                                        <span id="checkoutShipping">
                                            <span class="calculating-text">Nhập địa chỉ để tính phí</span>
                                        </span>
                                    </div>
                                    <div class="total-row distance-row" id="distanceRow" style="display: none;">
                                        <span>Khoảng cách:</span>
                                        <span id="checkoutDistance">0 km</span>
                                    </div>
                                    <div class="total-row final-total">
                                        <span>Tổng cộng:</span>
                                        <span id="checkoutTotal">0đ</span>
                                    </div>
                                </div>
                                <div class="payment-methods">
                                    <h6>Phương thức thanh toán</h6>
                                    <div class="payment-option">
                                        <input type="radio" id="paymentCash" name="paymentMethod" value="cash" checked>
                                        <label for="paymentCash">
                                            <i class="fas fa-money-bill-wave mr-2"></i>
                                            Thanh toán khi nhận hàng
                                        </label>
                                    </div>
                                    <div class="payment-option">
                                        <input type="radio" id="paymentOnline" name="paymentMethod" value="online">
                                        <label for="paymentOnline">
                                            <i class="fas fa-credit-card mr-2"></i>
                                            Chuyển khoản ngân hàng
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer checkout-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">
                        <i class="fas fa-arrow-left mr-2"></i>
                        Quay lại
                    </button>
                    <button type="button" class="btn btn-success btn-place-order" id="btnPlaceOrder">
                        <i class="fas fa-check mr-2"></i>
                        Đặt hàng ngay
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Thêm event listener cho dropdown navigation
        $(document).ready(function() {
            // Thêm click event cho tất cả dropdown items
            $('.dropdown-item').each(function() {
                var text = $(this).text().trim();
                if (text === 'Thông tin cá nhân') {
                    $(this).css('cursor', 'pointer').on('click', function(e) {
                        e.preventDefault();
                        window.location.href = '/Member/Index';
                    });
                } else if (text === 'Lịch sử đơn hàng') {
                    $(this).css('cursor', 'pointer').on('click', function(e) {
                        e.preventDefault();
                        window.location.href = '/Member/OrderHistory';
                    });
                }
            });
        });
    </script>

    <style>
        /* Modern Modal Styles */
        .modern-modal {
            border: none;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
            overflow: hidden;
            animation: modalSlideIn 0.4s ease-out;
        }

        .fas {
            margin-right: 4px;
        }

        @@keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(-50px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .gradient-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 25px 30px;
        }

        .gradient-header .modal-title {
            font-weight: 600;
            font-size: 1.4rem;
        }

        .modern-close {
            color: white;
            opacity: 0.8;
            font-size: 1.2rem;
            border: none;
            background: none;
            transition: all 0.3s ease;
        }

        .modern-close:hover {
            opacity: 1;
            transform: rotate(90deg);
        }

        .modern-body {
            padding: 15px;
            background: #f8f9fa;
            position: relative;
            min-height: 300px;
            overflow: hidden;
        }

        .modern-body::after {
            content: "";
            display: table;
            clear: both;
        }

        .product-image-container {
            display: flex;
            padding: 0 15px;
            padding-bottom: 10px;
            float: left;
            width: auto;
        }

        .product-image {
            width: 130px;
            height: 130px;
            border-radius: 6px;
            border: 1px solid #f4f4f4;
        }

        .product-image:hover {
            transform: scale(1.05);
        }

        .image-overlay {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(255,255,255,0.9);
            padding: 8px 12px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
        }

        .product-info {
            padding-left: 15px;
            float: left;
            width: auto;
        }

        .product-title {
            color: #333;
            font-weight: 700;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .product-description {
            color: #666;
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 15px;
        }

        .price-container {
            background: #d8b979;
            color: #ffffff;
            padding: 0 15px;
            height: 28px;
            line-height: 28px;
            border-radius: 25px;
            border: none;
            box-shadow: unset;
            margin-left: 20px;
            cursor: pointer;
        }

        .price-label {
            font-size: 0.9rem;
            margin-right: 6px;
        }

        .price-value {
            font-size: 1.3rem;
            font-weight: 700;
        }

        .quantity-section {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .section-label {
            color: #333;
            font-weight: 600;
            margin-bottom: 15px;
            display: block;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
        }

        .quantity-btn {
            color: #ffffff;
            background: #799dd9;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 0;
            line-height: 15px;
            font-size: 26px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
        }

        .quantity-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .quantity-input {
            padding: 0 15px;
            border: none;
            background: none;
            font-size: 1.2rem;
            font-weight: 600;
            text-align: center;
            width: 50px;
        }
        
        .quantity-input:focus {
            outline: none;
        }

        /* Ẩn arrow spinner của input number */
        .quantity-input::-webkit-outer-spin-button,
        .quantity-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .quantity-input[type=number] {
            -moz-appearance: textfield;
        }

        .options-section {
            margin-top: 20px;
            clear: both;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .option-card {
            background: linear-gradient(145deg, #ffffff, #f8f9fa);
            border-radius: 12px;
            border: 1px solid #e9ecef;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .option-card:hover {
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transform: translateY(-1px);
        }

        .option-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .option-header i {
            font-size: 14px;
            opacity: 0.9;
        }

        .option-header h6 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
        }

        /* Size Options */
        .size-options {
            padding: 12px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
            gap: 8px;
        }

        .size-option-item {
            position: relative;
            cursor: pointer;
        }

        .size-option-item input[type="radio"] {
            display: none;
        }

        .size-option-item label {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px 8px;
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .size-option-item label:hover {
            background: #e3f2fd;
            border-color: #2196f3;
        }

        .size-option-item input:checked + label {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border-color: #667eea;
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .size-option-item .size-name {
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 2px;
        }

        .size-option-item .size-price {
            font-size: 11px;
            opacity: 0.8;
        }

        /* Customize Row */
        .customize-row {
            padding: 15px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .customize-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .customize-item label {
            font-size: 12px;
            font-weight: 600;
            color: #555;
            margin: 0;
        }

        .custom-select {
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 13px;
            background: white;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .custom-select:focus {
            border-color: #667eea;
            outline: none;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        /* Topping Grid */
        .topping-grid {
            padding: 15px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 8px;
        }

        .topping-option-item {
            position: relative;
            cursor: pointer;
        }

        .topping-option-item input[type="checkbox"] {
            display: none;
        }

        .topping-option-item label {
            display: block;
            padding: 10px 12px;
            background: #f8f9fa;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 12px;
            text-align: center;
            position: relative;
        }

        .topping-option-item label:hover {
            background: #fff3e0;
            border-color: #ff9800;
        }

        .topping-option-item input:checked + label {
            background: linear-gradient(135deg, #ffa726, #ff9800);
            color: white;
            border-color: #ff9800;
            box-shadow: 0 3px 10px rgba(255, 152, 0, 0.3);
        }

        .topping-option-item .topping-name {
            display: block;
            font-weight: 600;
            margin-bottom: 2px;
        }

        .topping-option-item .topping-price {
            display: block;
            font-size: 11px;
            opacity: 0.8;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .options-container {
                gap: 12px;
            }
            
            .size-options {
                grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
                gap: 8px;
            }
            
            .customize-row {
                grid-template-columns: 1fr;
                gap: 12px;
            }
            
            .topping-grid {
                grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
                gap: 6px;
            }
        }

        .modern-footer {
            display: flex;
            border: none;
            gap: 15px;
            margin-top: 20px;
        }

        .total-section {
            background: linear-gradient(135deg, #ffa62e, #ea4d2c);
            color: white;
            padding: 10px 15px;;
            border-radius: 12px;
        }

        .total-label {
            font-size: 10px;
            margin-right: 10px;
        }

        .total-price {
            font-size: 14px;
            font-weight: 900;
            color:white;
        }

        .btn-add-cart {
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            border: none;
            padding: 10px 15px;;
            border-radius: 25px;
            color: white;
            font-weight: 600;
            font-size: 10px;
            transition: all 0.3s ease;
        }

        .btn-add-cart:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 107, 107, 0.3);
            color: white;
        }

        /* Toast Notification Styles */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        .toast-notification {
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.12);
            padding: 12px 15px;
            margin-bottom: 10px;
            min-width: 280px;
            max-width: 320px;
            transform: translateX(350px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            border-left: 4px solid #28a745;
        }

        .toast-notification.show {
            transform: translateX(0);
            opacity: 1;
        }

        .toast-notification.hide {
            transform: translateX(350px);
            opacity: 0;
        }

        .toast-header {
            display: flex;
            align-items: center;
            margin-bottom: 6px;
        }

        .toast-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #28a745, #20c997);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            margin-right: 12px;
            animation: bounceIn 0.5s ease;
            font-size: 14px;
        }

        @@keyframes bounceIn {
            0% { transform: scale(0.3); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-weight: 600;
            color: #333;
            margin-bottom: 3px;
            font-size: 14px;
        }

        .toast-message {
            color: #666;
            font-size: 13px;
            line-height: 1.4;
        }

        .toast-close {
            background: none;
            border: none;
            font-size: 16px;
            color: #999;
            cursor: pointer;
            padding: 0;
            margin-left: 10px;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toast-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(90deg, #28a745, #20c997);
            border-radius: 0 0 10px 10px;
            animation: progressBar 3s linear forwards;
        }

        @@keyframes progressBar {
            from { width: 100%; }
            to { width: 0%; }
        }

        @@keyframes loadingBar {
            0% { width: 0%; }
            50% { width: 100%; }
            100% { width: 0%; }
        }

        /* Animation cho category - Tối ưu performance */
        .category-name {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            user-select: none;
        }

        .category-name:hover {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
            transform: translateX(5px);
        }

        .category-name:active {
            transform: scale(0.98);
        }

        .list-product {
            overflow: hidden;
            transition: transform 0.15s ease-out;
            transform-origin: top center;
            will-change: transform;
            backface-visibility: hidden;
            transform: translateZ(0) scaleY(0); /* Start hidden */
        }

        .list-product.closing {
            transform: translateZ(0) scaleY(0);
            pointer-events: none;
        }

        .list-product.opening {
            transform: translateZ(0) scaleY(1);
        }

        .list-product.closed {
            display: none;
        }

        /* Product hover effects - Tối ưu performance */
        .product {
            transition: transform 0.2s ease-out;
            will-change: transform;
            backface-visibility: hidden;
            transform: translateZ(0);
        }

        .product:hover {
            transform: translateY(-3px) translateZ(0);
        }

        .btn-increase {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            will-change: transform;
        }

        .btn-increase:hover {
            transform: scale(1.15);
            background: linear-gradient(135deg, #ff6b6b, #ee5a24) !important;
            box-shadow: 0 8px 20px rgba(255, 107, 107, 0.3);
        }

        /* Smooth scrolling performance */
        .order-center {
            scroll-behavior: smooth;
        }

        /* Reduce motion for users who prefer it */
        @@media (prefers-reduced-motion: reduce) {
            .list-product,
            .product,
            .category-name,
            .btn-increase {
                transition: none !important;
                animation: none !important;
            }
        }

        /* User Avatar Styles */
        .user-avatar-container {
