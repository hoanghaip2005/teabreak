@model IEnumerable<App.Models.Toocha.Order>
@using App.Models.Toocha

@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-shopping-cart mr-2"></i>Quản lý đơn hàng</h4>
                </div>
                <div class="card-body">
                    <!-- Thống kê tổng quan -->
                    <div class="row mb-4" id="orderStats">
                        <div class="col-md-3">
                            <div class="stat-card bg-info">
                                <div class="stat-icon"><i class="fas fa-calendar-day"></i></div>
                                <div class="stat-content">
                                    <h6>Đơn hàng hôm nay</h6>
                                    <h4 id="todayOrders">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-success">
                                <div class="stat-icon"><i class="fas fa-money-bill-wave"></i></div>
                                <div class="stat-content">
                                    <h6>Doanh thu hôm nay</h6>
                                    <h4 id="todayRevenue">0đ</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-warning">
                                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                                <div class="stat-content">
                                    <h6>Chờ xử lý</h6>
                                    <h4 id="pendingOrders">0</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card bg-primary">
                                <div class="stat-icon"><i class="fas fa-cog"></i></div>
                                <div class="stat-content">
                                    <h6>Đang xử lý</h6>
                                    <h4 id="processingOrders">0</h4>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bộ lọc -->
                    <form method="get" class="filter-form mb-4">
                        <div class="row">
                            <div class="col-md-3">
                                <label for="status">Trạng thái:</label>
                                <select name="status" id="status" class="form-control">
                                    <option value="">Tất cả</option>
                                    <option value="Pending" @(ViewBag.CurrentStatus == "Pending" ? "selected" : "")>Chờ xử lý</option>
                                    <option value="Processing" @(ViewBag.CurrentStatus == "Processing" ? "selected" : "")>Đang xử lý</option>
                                    <option value="Shipped" @(ViewBag.CurrentStatus == "Shipped" ? "selected" : "")>Đã giao vận</option>
                                    <option value="Delivered" @(ViewBag.CurrentStatus == "Delivered" ? "selected" : "")>Đã giao</option>
                                    <option value="Cancelled" @(ViewBag.CurrentStatus == "Cancelled" ? "selected" : "")>Đã hủy</option>
                                    <option value="Failed" @(ViewBag.CurrentStatus == "Failed" ? "selected" : "")>Thất bại</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="search">Tìm kiếm:</label>
                                <input type="text" name="search" id="search" class="form-control" 
                                       placeholder="SĐT, địa chỉ, tên KH..." value="@ViewBag.CurrentSearch">
                            </div>
                            <div class="col-md-2">
                                <label for="fromDate">Từ ngày:</label>
                                <input type="date" name="fromDate" id="fromDate" class="form-control" 
                                       value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))">
                            </div>
                            <div class="col-md-2">
                                <label for="toDate">Đến ngày:</label>
                                <input type="date" name="toDate" id="toDate" class="form-control" 
                                       value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))">
                            </div>
                            <div class="col-md-2">
                                <label>&nbsp;</label>
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="fas fa-search mr-1"></i>Lọc
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Bảng đơn hàng -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Mã đơn hàng</th>
                                    <th>Khách hàng</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thanh toán</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@order.Id.ToString("D6")</strong>
                                            </td>
                                            <td>
                                                <div class="customer-info">
                                                    <div><strong>@(order.User?.UserName ?? "Khách vãng lai")</strong></div>
                                                    <small class="text-muted">@order.PhoneNumber</small>
                                                </div>
                                            </td>
                                            <td>
                                                <div>@order.OrderDate.ToString("dd/MM/yyyy")</div>
                                                <small class="text-muted">@order.OrderDate.ToString("HH:mm")</small>
                                            </td>
                                            <td>
                                                <strong class="text-success">@order.TotalPrice.ToString("N0")đ</strong>
                                                <div>
                                                    <small class="text-muted">@order.OrderItems.Sum(oi => oi.Quantity) món</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(order.Status)">
                                                    @GetStatusText(order.Status)
                                                </span>
                                            </td>
                                            <td>
                                                <div>
                                                    <span class="badge @(order.IsPaid ? "badge-success" : "badge-warning")">
                                                        @(order.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
                                                    </span>
                                                </div>
                                                <small class="text-muted">@order.PaymentMethod</small>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("OrderDetails", new { id = order.Id })" 
                                                       class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    @if (CanUpdateStatus(order.Status))
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-success" 
                                                                onclick="showUpdateStatusModal(@order.Id, '@order.Status')" 
                                                                title="Cập nhật trạng thái">
                                                            <i class="fas fa-edit"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4">
                                            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
                                            <div>Không có đơn hàng nào</div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Phân trang -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?page=@i&status=@ViewBag.CurrentStatus&search=@ViewBag.CurrentSearch&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                    <!-- Thông tin tổng quan -->
                    <div class="row mt-3">
                        <div class="col-12 text-center text-muted">
                            Hiển thị @Model.Count() trong tổng số @ViewBag.TotalOrders đơn hàng
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal cập nhật trạng thái -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật trạng thái đơn hàng</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="updateStatusForm">
                    <input type="hidden" id="orderId" />
                    <div class="form-group">
                        <label for="newStatus">Trạng thái mới:</label>
                        <select id="newStatus" class="form-control">
                            <!-- Options sẽ được load bằng JavaScript -->
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="updateOrderStatus()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Chờ xử lý",
            OrderStatus.Processing => "Đang xử lý",
            OrderStatus.Shipped => "Đã giao vận",
            OrderStatus.Delivered => "Đã giao",
            OrderStatus.Cancelled => "Đã hủy",
            OrderStatus.Failed => "Thất bại",
            _ => status.ToString()
        };
    }

    private string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "badge-warning",
            OrderStatus.Processing => "badge-info",
            OrderStatus.Shipped => "badge-primary",
            OrderStatus.Delivered => "badge-success",
            OrderStatus.Cancelled => "badge-danger",
            OrderStatus.Failed => "badge-dark",
            _ => "badge-secondary"
        };
    }

    private bool CanUpdateStatus(OrderStatus status)
    {
        return status != OrderStatus.Delivered && status != OrderStatus.Cancelled;
    }
}

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container-fluid {
        background: transparent;
        padding: 20px;
    }

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
        background: rgba(255,255,255,0.95);
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        padding: 25px 30px;
        border-radius: 20px 20px 0 0;
    }

    .card-header h4 {
        margin: 0;
        font-weight: 700;
        font-size: 1.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    .stat-card {
        background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        border: none;
        display: flex;
        align-items: center;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 6px;
        height: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .stat-card.bg-info::before { 
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
    }
    .stat-card.bg-success::before { 
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }
    .stat-card.bg-warning::before { 
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
    }
    .stat-card.bg-primary::before { 
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
    }

    .stat-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    .stat-icon {
        font-size: 3em;
        margin-right: 20px;
        opacity: 0.8;
        color: #667eea;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .stat-content h6 {
        margin: 0;
        font-size: 0.9em;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .stat-content h4 {
        margin: 5px 0 0 0;
        font-weight: 800;
        color: #2d3748;
        font-size: 2rem;
    }

    .filter-form {
        background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.1);
        backdrop-filter: blur(10px);
        margin-bottom: 30px;
    }

    .filter-form label {
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 8px;
    }

    .form-control {
        border: 2px solid rgba(0,0,0,0.1);
        border-radius: 15px;
        padding: 12px 16px;
        transition: all 0.3s ease;
        background: rgba(255,255,255,0.8);
    }

    .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        background: white;
    }

    .btn {
        border-radius: 15px;
        font-weight: 600;
        padding: 12px 20px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
    }

    .customer-info {
        min-width: 150px;
    }

    .table-responsive {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .table {
        margin: 0;
        background: white;
    }

    .table th {
        border: none;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #495057;
        padding: 20px 15px;
    }

    .table td {
        vertical-align: middle;
        border-top: 1px solid rgba(0,0,0,0.05);
        padding: 18px 15px;
    }

    .table tbody tr {
        transition: all 0.3s ease;
    }

    .table tbody tr:hover {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 50%, #f8f9fa 100%);
        transform: scale(1.01);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .badge {
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        color: white;
    }

    .badge-info {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
        color: white;
    }

    .badge-primary {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        color: white;
    }

    .badge-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .badge-danger {
        background: linear-gradient(135deg, #dc3545 0%, #e83e8c 100%);
        color: white;
    }

    .badge-dark {
        background: linear-gradient(135deg, #343a40 0%, #495057 100%);
        color: white;
    }

    .btn-group .btn {
        margin-right: 5px;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-outline-primary {
        border-color: #667eea;
        color: #667eea;
    }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #667eea;
        color: white;
    }

    .btn-outline-success {
        border-color: #28a745;
        color: #28a745;
    }

    .btn-outline-success:hover {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-color: #28a745;
        color: white;
    }

    .pagination .page-link {
        border-radius: 15px;
        margin: 0 5px;
        border: 2px solid transparent;
        color: #667eea;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .pagination .page-item.active .page-link {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-color: #667eea;
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .modal-content {
        border-radius: 20px;
        border: none;
        box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    }

    .modal-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 20px 20px 0 0;
        border: none;
    }

    .text-success {
        color: #28a745 !important;
        font-weight: 700;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .fa-3x {
        font-size: 3em;
        color: #dee2e6;
    }
</style>

<script>
$(document).ready(function() {
    loadOrderStats();
});

function loadOrderStats() {
    $.get('@Url.Action("GetOrderStats")', function(data) {
        $('#todayOrders').text(data.todayOrders);
        $('#todayRevenue').text(data.todayRevenue.toLocaleString() + 'đ');
        $('#pendingOrders').text(data.pendingOrders);
        $('#processingOrders').text(data.processingOrders);
    });
}

function showUpdateStatusModal(orderId, currentStatus) {
    $('#orderId').val(orderId);
    
    // Load available status options
    var statusOptions = getAvailableStatuses(currentStatus);
    var selectHtml = '';
    statusOptions.forEach(function(status) {
        selectHtml += `<option value="${status.value}">${status.text}</option>`;
    });
    $('#newStatus').html(selectHtml);
    
    $('#updateStatusModal').modal('show');
}

function getAvailableStatuses(currentStatus) {
    var statuses = [];
    
    switch(currentStatus) {
        case 'Pending':
            statuses.push({value: 'Processing', text: 'Đang xử lý'});
            statuses.push({value: 'Cancelled', text: 'Hủy đơn hàng'});
            break;
        case 'Processing':
            statuses.push({value: 'Shipped', text: 'Đã giao vận'});
            statuses.push({value: 'Cancelled', text: 'Hủy đơn hàng'});
            break;
        case 'Shipped':
            statuses.push({value: 'Delivered', text: 'Đã giao thành công'});
            statuses.push({value: 'Failed', text: 'Giao hàng thất bại'});
            break;
        case 'Failed':
            statuses.push({value: 'Processing', text: 'Xử lý lại'});
            break;
    }
    
    return statuses;
}

function updateOrderStatus() {
    var orderId = $('#orderId').val();
    var newStatus = $('#newStatus').val();
    
    if (!newStatus) {
        alert('Vui lòng chọn trạng thái mới');
        return;
    }
    
    $.post('@Url.Action("UpdateOrderStatus")', {
        orderId: orderId,
        newStatus: newStatus
    }, function(response) {
        if (response.success) {
            alert('Cập nhật trạng thái thành công!');
            location.reload();
        } else {
            alert('Lỗi: ' + response.message);
        }
    });
}
</script> 