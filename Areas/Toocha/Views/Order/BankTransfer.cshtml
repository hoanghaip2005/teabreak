    <script>
        $(document).ready(function() {
            // Lấy dữ liệu đơn hàng từ URL parameters hoặc localStorage
            loadOrderData();
            
            // Khởi tạo payment method selection
            initializePaymentMethods();
            
            // Khởi tạo upload functionality
            initializeFileUpload();
            
            // Tạo QR code
            generateQRCode();
            
            // Xử lý xác nhận thanh toán
            $('#btnConfirmPayment').on('click', confirmPayment);
            
            // Xử lý kiểm tra thanh toán e-wallet
            $('#btnCheckPayment').on('click', checkPaymentStatus);
        });

        // Khởi tạo payment methods
        function initializePaymentMethods() {
            // Xử lý click chọn phương thức thanh toán
            $('.payment-method-item').on('click', function() {
                const method = $(this).data('method');
                
                // Remove active class from all items
                $('.payment-method-item').removeClass('active');
                
                // Add active class to clicked item
                $(this).addClass('active');
                
                // Switch payment details
                switchPaymentMethod(method);
            });
        }

        // Chuyển đổi phương thức thanh toán
        function switchPaymentMethod(method) {
            // Hide all details cards
            $('#bankDetails, #ewalletDetails').hide();
            $('#uploadSection, #ewalletActions').hide();
            $('.qr-actions').hide();
            
            // Clear existing QR
            $('#qrCodeContainer').html(`
                <div class="qr-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Đang chuyển đổi...</p>
                </div>
            `);
            
            if (method === 'bank') {
                $('#bankDetails, #uploadSection').show();
                $('#qrTitle').text('QR Code chuyển khoản');
                $('#qrNote').text('Quét mã QR để chuyển khoản nhanh chóng');
                
                // Generate bank QR
                setTimeout(() => {
                    generateQRCode(); // This will create VietQR
                }, 500);
            } else {
                $('#ewalletDetails, #ewalletActions').show();
                updateEwalletDetails(method);
                
                // Generate e-wallet QR
                setTimeout(() => {
                    generateEwalletQRCode(method);
                    startCountdown();
                }, 500);
            }
        }

        // Cập nhật thông tin e-wallet
        function updateEwalletDetails(method) {
            const methodInfo = {
                'momo': {
                    title: 'Thanh toán MoMo',
                    qrTitle: 'QR Code MoMo',
                    steps: [
                        'Mở ứng dụng MoMo trên điện thoại',
                        'Chọn "Quét mã QR" từ màn hình chính',
                        'Quét mã QR bên phải để thanh toán',
                        'Nhập mã PIN và xác nhận thanh toán'
                    ]
                },
                'zalopay': {
                    title: 'Thanh toán ZaloPay',
                    qrTitle: 'QR Code ZaloPay',
                    steps: [
                        'Mở ứng dụng ZaloPay trên điện thoại',
                        'Chọn "Quét QR" từ menu chính',
                        'Quét mã QR bên phải để thanh toán',
                        'Nhập mật khẩu và hoàn tất thanh toán'
                    ]
                },
                'vnpay': {
                    title: 'Thanh toán VNPay',
                    qrTitle: 'QR Code VNPay',
                    steps: [
                        'Mở ứng dụng ngân hàng có hỗ trợ VNPay QR',
                        'Chọn "Quét mã QR" hoặc "VNPay QR"',
                        'Quét mã QR bên phải để thanh toán',
                        'Xác nhận thông tin và hoàn tất giao dịch'
                    ]
                }
            };
            
            const info = methodInfo[method];
            $('#ewalletTitle').text(info.title);
            $('#qrTitle').text(info.qrTitle);
            
            // Update steps
            const stepsHtml = info.steps.map(step => `<li>${step}</li>`).join('');
            $('#ewalletSteps').html(stepsHtml);
            
            // Update amount display
            if (window.currentOrderData) {
                $('#ewalletAmount').text(window.currentOrderData.totalAmount.toLocaleString('vi-VN') + 'đ');
            }
        }

        // Load thông tin đơn hàng
        function loadOrderData() {
            // Lấy thông tin đơn hàng từ sessionStorage
            const orderInfoStr = sessionStorage.getItem('orderInfo');
            
            if (!orderInfoStr) {
                // Nếu không có thông tin đơn hàng, chuyển về trang đặt hàng
                showToast('Lỗi!', 'Không tìm thấy thông tin đơn hàng. Đang chuyển về trang đặt hàng...', 'error', 3000);
                setTimeout(() => {
                    window.location.href = '/Toocha/Order';
                }, 3000);
                return;
            }
            
            try {
                const orderData = JSON.parse(orderInfoStr);
                
                // Định dạng mã đơn hàng
                const formattedOrderId = '#' + orderData.orderId.toString().padStart(6, '0');
                
                // Cập nhật thông tin trên giao diện
                $('#orderIdDisplay').text(formattedOrderId);
                $('#customerNameDisplay').text(orderData.customerName);
                $('#customerPhoneDisplay').text(orderData.customerPhone);
                $('#customerAddressDisplay').text(orderData.customerAddress);
                $('#totalAmountDisplay').text(orderData.totalAmount.toLocaleString('vi-VN') + 'đ');
                $('#transferAmount').text(orderData.totalAmount.toLocaleString('vi-VN') + 'đ');
                $('#transferContent').text(`TOOCHA ORDER ${orderData.orderId.toString().padStart(6, '0')}`);
                
                // Update copy button cho số tiền (chỉ số, không có dấu phẩy)
                $('.amount-highlight .btn-copy').attr('onclick', `copyToClipboard('${orderData.totalAmount}')`);
                
                // Hiển thị thông tin cửa hàng nếu có
                if (orderData.storeName) {
                    const storeInfo = `${orderData.storeName} (${orderData.distance}km)`;
                    const shippingInfo = orderData.shippingFee === 0 ? 
                        'Miễn phí giao hàng' : 
                        `Phí giao hàng: ${orderData.shippingFee.toLocaleString('vi-VN')}đ`;
                    
                    // Thêm thông tin cửa hàng vào địa chỉ giao hàng
                    const fullAddress = `${orderData.customerAddress}<br><small class="text-muted">Giao từ: ${storeInfo} • ${shippingInfo}</small>`;
                    $('#customerAddressDisplay').html(fullAddress);
                }
                
                // Lưu dữ liệu để sử dụng trong các function khác
                window.currentOrderData = orderData;
                
            } catch (error) {
                console.error('Error parsing order data:', error);
                showToast('Lỗi!', 'Dữ liệu đơn hàng không hợp lệ. Đang chuyển về trang đặt hàng...', 'error', 3000);
                setTimeout(() => {
                    window.location.href = '/Toocha/Order';
                }, 3000);
            }
        }

        // Khởi tạo upload functionality
        function initializeFileUpload() {
            const uploadArea = $('#uploadArea');
            const fileInput = $('#paymentProof');
            let uploadedFiles = [];

            // Click to select files
            uploadArea.on('click', function() {
                fileInput.click();
            });

            // Drag and drop functionality
            uploadArea.on('dragover', function(e) {
                e.preventDefault();
                $(this).addClass('dragover');
            });

            uploadArea.on('dragleave', function(e) {
                e.preventDefault();
                $(this).removeClass('dragover');
            });

            uploadArea.on('drop', function(e) {
                e.preventDefault();
                $(this).removeClass('dragover');
                
                const files = e.originalEvent.dataTransfer.files;
                handleFiles(files);
            });

            // File input change
            fileInput.on('change', function() {
                handleFiles(this.files);
            });

            function handleFiles(files) {
                for (let file of files) {
                    if (validateFile(file)) {
                        uploadedFiles.push(file);
                        addFileToList(file);
                    }
                }
                updateUploadState();
            }

            function validateFile(file) {
                const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'application/pdf'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!allowedTypes.includes(file.type)) {
                    showToast('Lỗi!', 'Chỉ hỗ trợ file JPG, PNG, PDF', 'error');
                    return false;
                }

                if (file.size > maxSize) {
                    showToast('Lỗi!', 'File không được vượt quá 5MB', 'error');
                    return false;
                }

                return true;
            }

            function addFileToList(file) {
                const fileId = 'file_' + Date.now();
                const fileSize = (file.size / 1024 / 1024).toFixed(2) + ' MB';
                const fileIcon = file.type.includes('image') ? 'fa-image' : 'fa-file-pdf';

                const fileHtml = `
                    <div class="file-item" data-file-id="${fileId}">
                        <div class="file-info">
                            <i class="fas ${fileIcon} file-icon"></i>
                            <div>
                                <div class="file-name">${file.name}</div>
                                <div class="file-size">${fileSize}</div>
                            </div>
                        </div>
                        <button class="btn-remove-file" onclick="removeFile('${fileId}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;

                $('#filesList').append(fileHtml);
                $('#uploadedFiles').show();
            }

            // Remove file function (global scope)
            window.removeFile = function(fileId) {
                const index = uploadedFiles.findIndex(file => 'file_' + Date.now() === fileId);
                if (index > -1) {
                    uploadedFiles.splice(index, 1);
                }
                
                $(`.file-item[data-file-id="${fileId}"]`).remove();
                
                if (uploadedFiles.length === 0) {
                    $('#uploadedFiles').hide();
                }
                
                updateUploadState();
            };

            function updateUploadState() {
                const hasFiles = uploadedFiles.length > 0;
                $('#btnConfirmPayment').prop('disabled', !hasFiles);
                
                if (hasFiles) {
                    showToast('Thành công!', `Đã upload ${uploadedFiles.length} file`, 'success', 2000);
                }
            }
        }

        // Tạo QR Code - VietQR cho chuyển khoản ngân hàng
        function generateQRCode() {
            const qrContainer = $('#qrCodeContainer');
            
            // Đợi dữ liệu đơn hàng được load
            if (!window.currentOrderData) {
                setTimeout(() => generateQRCode(), 500);
                return;
            }
            
            qrContainer.html(`
                <div class="qr-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Đang tạo mã QR VietQR...</p>
                </div>
            `);

            // Thông tin ngân hàng VietQR
            const bankInfo = {
                bankId: '970436', // Mã ngân hàng Vietcombank
                accountNo: '1021796868',
                template: 'compact2',
                amount: window.currentOrderData.totalAmount,
                description: $('#transferContent').text(),
                accountName: 'CONG TY TNHH TOOCHA TEA'
            };

            // Tạo URL VietQR API
            const vietqrUrl = `https://img.vietqr.io/image/${bankInfo.bankId}-${bankInfo.accountNo}-${bankInfo.template}.png?amount=${bankInfo.amount}&addInfo=${encodeURIComponent(bankInfo.description)}&accountName=${encodeURIComponent(bankInfo.accountName)}`;

            // Simulate loading time và tạo QR
            setTimeout(() => {
                const qrImage = new Image();
                qrImage.onload = function() {
                    qrContainer.html(`
                        <div style="text-align: center;">
                            <img src="${vietqrUrl}" alt="VietQR Code" style="max-width: 200px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);" />
                            <div style="margin-top: 10px; font-size: 0.8rem; color: #666;">
                                <i class="fas fa-shield-alt" style="color: #28a745;"></i>
                                Mã QR được tạo bởi VietQR
                            </div>
                        </div>
                    `);
                    
                    // Lưu QR data để download
                    window.currentQRData = vietqrUrl;
                    $('.qr-actions').show();
                    
                    showToast('Thành công!', 'Đã tạo mã QR VietQR. Quét để chuyển khoản nhanh chóng!', 'success', 3000);
                };
                
                qrImage.onerror = function() {
                    // Fallback to basic QR if VietQR fails
                    console.log('VietQR failed, using basic QR...');
                    generateBasicQRCode(bankInfo);
                };
                
                qrImage.src = vietqrUrl;
            }, 1000);
        }

        // Tạo QR Code cơ bản khi VietQR không khả dụng
        function generateBasicQRCode(bankInfo) {
            const qrContainer = $('#qrCodeContainer');
            const qrData = `Ngân hàng: Vietcombank\nSTK: ${bankInfo.accountNo}\nSố tiền: ${bankInfo.amount.toLocaleString('vi-VN')}đ\nNội dung: ${bankInfo.description}\nChủ TK: ${bankInfo.accountName}`;

            QRCode.toCanvas(qrData, {
                width: 200,
                height: 200,
                colorDark: '#333',
                colorLight: '#fff',
                correctLevel: QRCode.CorrectLevel.M,
                margin: 2
            }, function(error, canvas) {
                if (error) {
                    console.error('QR Code generation error:', error);
                    qrContainer.html(`
                        <div class="qr-error">
                            <i class="fas fa-exclamation-triangle" style="color: #dc3545; font-size: 2rem; margin-bottom: 10px;"></i>
                            <p style="color: #dc3545; margin: 0;">Không thể tạo mã QR</p>
                            <p style="color: #666; font-size: 0.8rem; margin: 5px 0 0 0;">Vui lòng chuyển khoản thủ công theo thông tin bên trái</p>
                        </div>
                    `);
                } else {
                    qrContainer.empty().append(canvas);
                    window.currentQRData = canvas.toDataURL();
                    $('.qr-actions').show();
                    
                    // Thêm hiệu ứng xuất hiện
                    $(canvas).css({
                        'opacity': '0',
                        'transform': 'scale(0.8)'
                    }).animate({
                        'opacity': '1'
                    }, 300).css({
                        'transform': 'scale(1)',
                        'transition': 'transform 0.3s ease'
                    });
                    
                    showToast('Thông báo', 'Đã tạo mã QR cơ bản. Một số ứng dụng ngân hàng có thể không hỗ trợ quét mã này.', 'info', 4000);
                }
            });
        }

        // Download QR Code
        window.downloadQR = function() {
            if (!window.currentQRData) {
                showToast('Lỗi!', 'Không có mã QR để tải xuống', 'error');
                return;
            }

            const link = document.createElement('a');
            link.download = `toocha-qr-${window.currentOrderData ? window.currentOrderData.orderId.toString().padStart(6, '0') : Date.now()}.png`;
            
            if (window.currentQRData.startsWith('http')) {
                // For VietQR URL - fetch and download
                fetch(window.currentQRData)
                    .then(response => response.blob())
                    .then(blob => {
                        const url = window.URL.createObjectURL(blob);
                        link.href = url;
                        link.click();
                        window.URL.revokeObjectURL(url);
                        showToast('Thành công!', 'Đã tải xuống mã QR', 'success', 2000);
                    })
                    .catch(() => {
                        link.href = window.currentQRData;
                        link.target = '_blank';
                        link.click();
                    });
            } else {
                // For canvas data URL
                link.href = window.currentQRData;
                link.click();
                showToast('Thành công!', 'Đã tải xuống mã QR', 'success', 2000);
            }
        };

        // Tạo QR Code cho chuyển khoản ngân hàng (VietQR)
        function generateBankQRCode() {
            const qrContainer = $('#qrCodeContainer');
            
            // Đợi dữ liệu đơn hàng được load
            if (!window.currentOrderData) {
                setTimeout(() => generateBankQRCode(), 500);
                return;
            }
            
            qrContainer.html(`
                <div class="qr-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Đang tạo mã QR VietQR...</p>
                </div>
            `);

            // Tạo VietQR theo chuẩn Napas
            const bankInfo = {
                bankId: '970436', // Mã ngân hàng Vietcombank
                accountNo: '1021796868',
                template: 'compact2',
                amount: window.currentOrderData.totalAmount,
                description: $('#transferContent').text(),
                accountName: 'CONG TY TNHH TOOCHA TEA'
            };

            // Tạo URL VietQR API
            const vietqrUrl = `https://img.vietqr.io/image/${bankInfo.bankId}-${bankInfo.accountNo}-${bankInfo.template}.png?amount=${bankInfo.amount}&addInfo=${encodeURIComponent(bankInfo.description)}&accountName=${encodeURIComponent(bankInfo.accountName)}`;

            // Tạo QR code với URL VietQR
            setTimeout(() => {
                const qrImage = new Image();
                qrImage.onload = function() {
                    qrContainer.html(`
                        <img src="${vietqrUrl}" alt="VietQR Code" style="max-width: 200px; border-radius: 10px;" />
                    `);
                    
                    // Lưu QR data để download
                    window.currentQRData = vietqrUrl;
                    $('.qr-actions').show();
                };
                
                qrImage.onerror = function() {
                    // Fallback to basic QR if VietQR fails
                    generateBasicQRCode(bankInfo);
                };
                
                qrImage.src = vietqrUrl;
            }, 1000);
        }

        // Tạo QR Code cơ bản khi VietQR không khả dụng
        function generateBasicQRCode(bankInfo) {
            const qrContainer = $('#qrCodeContainer');
            const qrData = `Bank: ${bankInfo.accountNo}\nAmount: ${bankInfo.amount}\nContent: ${bankInfo.description}`;

            QRCode.toCanvas(qrData, {
                width: 200,
                height: 200,
                colorDark: '#333',
                colorLight: '#fff',
                correctLevel: QRCode.CorrectLevel.M,
                margin: 2
            }, function(error, canvas) {
                if (error) {
                    console.error('QR Code generation error:', error);
                    qrContainer.html(`
                        <div class="qr-error">
                            <i class="fas fa-exclamation-triangle" style="color: #dc3545; font-size: 2rem; margin-bottom: 10px;"></i>
                            <p style="color: #dc3545; margin: 0;">Không thể tạo mã QR</p>
                            <p style="color: #666; font-size: 0.8rem; margin: 5px 0 0 0;">Vui lòng chuyển khoản thủ công</p>
                        </div>
                    `);
                } else {
                    qrContainer.empty().append(canvas);
                    window.currentQRData = canvas.toDataURL();
                    $('.qr-actions').show();
                }
            });
        }

        // Tạo QR Code cho e-wallet
        function generateEwalletQRCode(method) {
            const qrContainer = $('#qrCodeContainer');
            
            if (!window.currentOrderData) {
                setTimeout(() => generateEwalletQRCode(method), 500);
                return;
            }
            
            qrContainer.html(`
                <div class="qr-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Đang tạo mã thanh toán...</p>
                </div>
            `);

            // Simulate API call to create payment QR
            setTimeout(() => {
                createEwalletPayment(method);
            }, 1500);
        }

        // Tạo payment request cho e-wallet (simulation)
        function createEwalletPayment(method) {
            const qrContainer = $('#qrCodeContainer');
            const orderData = window.currentOrderData;
            
            const paymentData = {
                method: method,
                amount: orderData.totalAmount,
                orderId: orderData.orderId,
                description: `TOOCHA ORDER ${orderData.orderId.toString().padStart(6, '0')}`,
                returnUrl: window.location.href,
                notifyUrl: '/Toocha/Order/PaymentCallback'
            };

            console.log(`Creating ${method} payment:`, paymentData);
            
            // Tạo QR data cho từng loại ví
            let qrData = '';
            switch(method) {
                case 'momo':
                    qrData = JSON.stringify({
                        action: 'payWithApp',
                        amount: paymentData.amount,
                        description: paymentData.description,
                        orderId: paymentData.orderId,
                        merchantName: 'TOOCHA TEA'
                    });
                    break;
                case 'zalopay':
                    qrData = JSON.stringify({
                        app_id: 'zalopay',
                        amount: paymentData.amount,
                        description: paymentData.description,
                        order_id: paymentData.orderId
                    });
                    break;
                case 'vnpay':
                    qrData = `vnpay://pay?amount=${paymentData.amount}&orderId=${paymentData.orderId}&desc=${encodeURIComponent(paymentData.description)}`;
                    break;
                default:
                    qrData = `${method}://pay?amount=${paymentData.amount}&orderId=${paymentData.orderId}&desc=${encodeURIComponent(paymentData.description)}`;
            }
            
            QRCode.toCanvas(qrData, {
                width: 220,
                height: 220,
                colorDark: getMethodColor(method),
                colorLight: '#fff',
                correctLevel: QRCode.CorrectLevel.M,
                margin: 3
            }, function(error, canvas) {
                if (error) {
                    console.error(`${method} QR error:`, error);
                    qrContainer.html(`
                        <div class="qr-error">
                            <i class="fas fa-exclamation-triangle" style="color: #dc3545; font-size: 2rem; margin-bottom: 10px;"></i>
                            <p style="color: #dc3545; margin: 0;">Không thể tạo mã thanh toán ${method.toUpperCase()}</p>
                            <p style="color: #666; font-size: 0.8rem; margin: 5px 0 0 0;">Vui lòng thử lại sau</p>
                        </div>
                    `);
                } else {
                    // Tạo wrapper đẹp
                    const qrWrapper = document.createElement('div');
                    qrWrapper.style.cssText = `
                        text-align: center;
                        padding: 15px;
                        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
                        border-radius: 15px;
                        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
                    `;
                    
                    // Style canvas
                    canvas.style.cssText = `
                        border-radius: 10px;
                        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
                        border: 3px solid ${getMethodColor(method)};
                    `;
                    
                    qrWrapper.appendChild(canvas);
                    
                    // Badge
                    const badge = document.createElement('div');
                    badge.style.cssText = `
                        margin-top: 10px;
                        padding: 5px 15px;
                        background: ${getMethodColor(method)};
                        color: white;
                        border-radius: 20px;
                        font-size: 0.8rem;
                        font-weight: 600;
                        display: inline-block;
                        text-transform: uppercase;
                    `;
                    badge.textContent = `${method} Payment`;
                    qrWrapper.appendChild(badge);
                    
                    // Security note
                    const note = document.createElement('div');
                    note.style.cssText = `
                        margin-top: 8px;
                        font-size: 0.75rem;
                        color: #666;
                    `;
                    note.innerHTML = `<i class="fas fa-shield-alt" style="color: #28a745;"></i> Mã QR an toàn`;
                    qrWrapper.appendChild(note);
                    
                    qrContainer.empty().append(qrWrapper);
                    window.currentQRData = canvas.toDataURL();
                    $('.qr-actions').show();
                    
                    // Animation
                    $(qrWrapper).css({
                        'opacity': '0',
                        'transform': 'scale(0.8)'
                    }).animate({
                        'opacity': '1'
                    }, 400).css({
                        'transform': 'scale(1)',
                        'transition': 'transform 0.4s ease'
                    });
                    
                    showToast('Thành công!', `Đã tạo mã QR ${method.toUpperCase()}. Vui lòng quét để thanh toán.`, 'success', 3000);
                }
            });
        }

        // Lấy màu cho từng phương thức
        function getMethodColor(method) {
            const colors = {
                'momo': '#d63384',
                'zalopay': '#0d6efd', 
                'vnpay': '#fd7e14'
            };
            return colors[method] || '#333';
        }

        // Countdown timer cho e-wallet
        function startCountdown() {
            let timeLeft = 300; // 5 minutes
            const countdownElement = $('#countdown');
            
            const timer = setInterval(() => {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                
                countdownElement.text(`${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`);
                
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    $('#paymentStatus').html(`
                        <div class="status-expired">
                            <i class="fas fa-times-circle text-danger"></i>
                            <h6>Hết thời gian thanh toán</h6>
                            <p>Vui lòng tạo lại mã QR để tiếp tục</p>
                            <button class="btn btn-primary" onclick="location.reload()">Tạo lại</button>
                        </div>
                    `);
                }
                
                timeLeft--;
            }, 1000);
            
            // Save timer ID để có thể clear khi cần
            window.paymentTimer = timer;
        }

        // Kiểm tra trạng thái thanh toán
        function checkPaymentStatus() {
            const button = $('#btnCheckPayment');
            const originalText = button.html();
            
            button.html('<i class="fas fa-spinner fa-spin mr-2"></i>Đang kiểm tra...');
            button.prop('disabled', true);
            
            // Simulate payment check
            setTimeout(() => {
                // Mock random result for demo
                const isPaid = Math.random() > 0.7; // 30% chance of being paid
                
                if (isPaid) {
                    // Payment successful
                    clearInterval(window.paymentTimer);
                    $('#paymentStatus').html(`
                        <div class="status-success">
                            <i class="fas fa-check-circle text-success"></i>
                            <h6>Thanh toán thành công!</h6>
                            <p>Đơn hàng của bạn đã được xác nhận và đang được xử lý</p>
                        </div>
                    `);
                    
                    showToast('Thành công!', 'Thanh toán đã được xác nhận!', 'success', 5000);
                    
                    // Redirect after delay
                    setTimeout(() => {
                        window.location.href = '/Toocha/Order';
                    }, 3000);
                    
                } else {
                    // Payment not found
                    button.html(originalText);
                    button.prop('disabled', false);
                    
                    showToast('Thông báo', 'Chưa nhận được thanh toán. Vui lòng thử lại sau.', 'info', 3000);
                }
            }, 2000);
        }

        // Copy to clipboard function
        window.copyToClipboard = function(text) {
            navigator.clipboard.writeText(text).then(function() {
                showToast('Đã copy!', `Đã sao chép: ${text}`, 'success', 2000);
            }).catch(function(err) {
                // Fallback for older browsers
                const textArea = document.createElement('textarea');
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showToast('Đã copy!', `Đã sao chép: ${text}`, 'success', 2000);
            });
        };

        // Xác nhận thanh toán
        function confirmPayment() {
            const button = $('#btnConfirmPayment');
            const originalText = button.html();
            
            // Kiểm tra có file được upload chưa
            const uploadedFiles = $('.file-item').length;
            if (uploadedFiles === 0) {
                showToast('Thông báo', 'Vui lòng upload ảnh chuyển khoản trước khi xác nhận', 'error', 3000);
                return;
            }
            
            // Kiểm tra có thông tin đơn hàng không
            if (!window.currentOrderData) {
                showToast('Lỗi!', 'Không tìm thấy thông tin đơn hàng', 'error', 3000);
                return;
            }
            
            // Loading state
            button.html('<i class="fas fa-spinner fa-spin mr-2"></i>Đang xử lý...');
            button.prop('disabled', true);

            // Chuẩn bị dữ liệu gửi lên server
            const paymentData = {
                orderId: window.currentOrderData.orderId,
                paymentMethod: 'bank_transfer',
                paymentNote: $('#paymentNote').val().trim(),
                bankAccount: '1234567890',
                bankName: 'Vietcombank',
                transferAmount: window.currentOrderData.totalAmount,
                transferContent: $('#transferContent').text(),
                numberOfProofFiles: uploadedFiles
            };

            // Gọi API xác nhận thanh toán
            $.ajax({
                url: '/Toocha/Order/ConfirmBankTransfer',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(paymentData),
                success: function(response) {
                    if (response.success) {
                        // Success
                        button.html('<i class="fas fa-check mr-2"></i>Đã xác nhận!');
                        button.css('background', 'linear-gradient(135deg, #28a745, #20c997)');
                        
                        showToast(
                            'Xác nhận thành công!', 
                            `Cảm ơn ${window.currentOrderData.customerName}! Đơn hàng #${window.currentOrderData.orderId.toString().padStart(6, '0')} đã được ghi nhận. Chúng tôi sẽ kiểm tra và xác nhận thanh toán trong vòng 5-10 phút.`, 
                            'success', 
                            8000
                        );

                        // Xóa thông tin đơn hàng khỏi sessionStorage
                        sessionStorage.removeItem('orderInfo');
                        
                        // Redirect sau 3 giây
                        setTimeout(() => {
                            // Chuyển về trang chủ hoặc trang lịch sử đơn hàng
                            window.location.href = '/Toocha/Order';
                        }, 3000);
                        
                    } else {
                        // Error from server
                        button.html('<i class="fas fa-exclamation-triangle mr-2"></i>Có lỗi xảy ra');
                        button.css('background', 'linear-gradient(135deg, #dc3545, #c82333)');
                        
                        showToast('Lỗi!', response.message || 'Có lỗi xảy ra khi xác nhận thanh toán', 'error', 5000);
                        
                        // Reset button sau delay
                        setTimeout(() => {
                            button.html(originalText);
                            button.prop('disabled', false);
                            button.css('background', '');
                        }, 3000);
                    }
                },
                error: function(xhr, status, error) {
                    // AJAX Error
                    console.error('Payment confirmation error:', error);
                    button.html('<i class="fas fa-exclamation-triangle mr-2"></i>Kết nối thất bại');
                    button.css('background', 'linear-gradient(135deg, #dc3545, #c82333)');
                    
                    showToast('Lỗi kết nối!', 'Không thể kết nối đến server. Vui lòng thử lại sau.', 'error', 5000);
                    
                    // Reset button sau delay
                    setTimeout(() => {
                        button.html(originalText);
                        button.prop('disabled', false);
                        button.css('background', '');
                    }, 3000);
                }
            });
        }

        // Toast notification function
        function showToast(title, message, type = 'success', duration = 3000) {
            const toastId = 'toast_' + Date.now();
            const iconClass = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
            const borderColor = type === 'success' ? '#28a745' : '#dc3545';
            
            const toastHtml = `
                <div id="${toastId}" class="toast-notification" style="border-left-color: ${borderColor};">
                    <div style="display: flex; align-items: flex-start; gap: 10px;">
                        <i class="fas ${iconClass}" style="color: ${borderColor}; margin-top: 2px;"></i>
                        <div style="flex: 1;">
                            <div style="font-weight: 600; margin-bottom: 4px;">${title}</div>
                            <div style="font-size: 13px; color: #666;">${message}</div>
                        </div>
                        <button onclick="hideToast('${toastId}')" style="background: none; border: none; font-size: 16px; color: #999; cursor: pointer;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `;
            
            $('#toast-container').append(toastHtml);
            
            setTimeout(() => {
                $(`#${toastId}`).addClass('show');
            }, 100);
            
            setTimeout(() => {
                hideToast(toastId);
            }, duration);
            
            return toastId;
        }

        function hideToast(toastId) {
            const toast = $(`#${toastId}`);
            toast.removeClass('show').addClass('hide');
            setTimeout(() => {
                toast.remove();
            }, 300);
        }
    </script>
</body>
</html> 