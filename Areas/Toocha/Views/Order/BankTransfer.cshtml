@model dynamic

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán trực tuyến - TOOCHA TEA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/Areas/Toocha/assets/css/order.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://kit.fontawesome.com/5ca428eb12.js" crossorigin="anonymous"></script>
</head>
<body>
    @Html.AntiForgeryToken()
    
    <header class="header">
        <a href="/Toocha/Order" class="logo">
            <i class="fas fa-arrow-left mr-2"></i>
            TOOCHA TEA
        </a>
        <div class="header-title">
            <h4 class="mb-0">Thanh toán trực tuyến</h4>
        </div>
    </header>

    <div class="bank-transfer-container">
        <div class="container-fluid">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="bank-transfer-content">
                        <!-- Order Summary Card -->
                        <div class="card order-summary-card">
                            <div class="card-header gradient-header">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-receipt mr-2"></i>
                                    Thông tin đơn hàng
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="order-info">
                                    <div class="order-row">
                                        <span class="order-label">Mã đơn hàng:</span>
                                        <span class="order-value order-id" id="orderIdDisplay">#000001</span>
                                    </div>
                                    <div class="order-row">
                                        <span class="order-label">Khách hàng:</span>
                                        <span class="order-value" id="customerNameDisplay">Nguyễn Văn A</span>
                                    </div>
                                    <div class="order-row">
                                        <span class="order-label">Số điện thoại:</span>
                                        <span class="order-value" id="customerPhoneDisplay">0987654321</span>
                                    </div>
                                    <div class="order-row">
                                        <span class="order-label">Địa chỉ giao hàng:</span>
                                        <span class="order-value" id="customerAddressDisplay">123 Đường ABC, Quận 1, TP.HCM</span>
                                    </div>
                                    <div class="order-row total-row">
                                        <span class="order-label">Tổng thanh toán:</span>
                                        <span class="order-value total-amount" id="totalAmountDisplay">150,000đ</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method Selection -->
                        <div class="card payment-method-card">
                            <div class="card-header gradient-header">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-credit-card mr-2"></i>
                                    Chọn phương thức thanh toán
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="payment-methods-grid">
                                    <div class="payment-method-item active" data-method="bank">
                                        <div class="payment-icon bank-icon">
                                            <i class="fas fa-university"></i>
                                        </div>
                                        <div class="payment-info">
                                            <h6>Chuyển khoản ngân hàng</h6>
                                            <small>Vietcombank, ACB, Techcombank...</small>
                                        </div>
                                        <div class="payment-badge">
                                            <span class="badge badge-success">Miễn phí</span>
                                        </div>
                                    </div>
                                    
                                    <div class="payment-method-item" data-method="momo">
                                        <div class="payment-icon momo-icon">
                                            <i class="fas fa-mobile-alt"></i>
                                        </div>
                                        <div class="payment-info">
                                            <h6>Ví MoMo</h6>
                                            <small>Thanh toán qua ví điện tử MoMo</small>
                                        </div>
                                        <div class="payment-badge">
                                            <span class="badge badge-info">Nhanh chóng</span>
                                        </div>
                                    </div>
                                    
                                    <div class="payment-method-item" data-method="zalopay">
                                        <div class="payment-icon zalopay-icon">
                                            <i class="fas fa-wallet"></i>
                                        </div>
                                        <div class="payment-info">
                                            <h6>ZaloPay</h6>
                                            <small>Thanh toán qua ví ZaloPay</small>
                                        </div>
                                        <div class="payment-badge">
                                            <span class="badge badge-primary">Ưu đãi</span>
                                        </div>
                                    </div>
                                    
                                    <div class="payment-method-item" data-method="vnpay">
                                        <div class="payment-icon vnpay-icon">
                                            <i class="fas fa-credit-card"></i>
                                        </div>
                                        <div class="payment-info">
                                            <h6>VNPay</h6>
                                            <small>Thẻ ATM, Visa, MasterCard</small>
                                        </div>
                                        <div class="payment-badge">
                                            <span class="badge badge-warning">An toàn</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Payment Details Card -->
                            <div class="col-lg-6">
                                <!-- Bank Transfer Section -->
                                <div class="card payment-details-card" id="bankDetails">
                                    <div class="card-header gradient-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-university mr-2"></i>
                                            Thông tin chuyển khoản
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="bank-details">
                                            <div class="bank-item">
                                                <label>Ngân hàng:</label>
                                                <div class="bank-value">
                                                    <strong>Ngân hàng TMCP Ngoại Thương Việt Nam (Vietcombank)</strong>
                                                    <button class="btn-copy" onclick="copyToClipboard('Vietcombank')" title="Copy">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <div class="bank-item">
                                                <label>Số tài khoản:</label>
                                                <div class="bank-value">
                                                    <strong>1021796868</strong>
                                                    <button class="btn-copy" onclick="copyToClipboard('1021796868')" title="Copy số tài khoản">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <div class="bank-item">
                                                <label>Chủ tài khoản:</label>
                                                <div class="bank-value">
                                                    <strong>CONG TY TNHH TOOCHA TEA</strong>
                                                    <button class="btn-copy" onclick="copyToClipboard('CONG TY TNHH TOOCHA TEA')" title="Copy tên tài khoản">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <div class="bank-item">
                                                <label>Số tiền:</label>
                                                <div class="bank-value amount-highlight">
                                                    <strong id="transferAmount">150,000đ</strong>
                                                    <button class="btn-copy" onclick="copyToClipboard('150000')" title="Copy số tiền">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <div class="bank-item">
                                                <label>Nội dung chuyển khoản:</label>
                                                <div class="bank-value transfer-content">
                                                    <strong id="transferContent">TOOCHA ORDER 000001</strong>
                                                    <button class="btn-copy" onclick="copyToClipboard(document.getElementById('transferContent').textContent)" title="Copy nội dung">
                                                        <i class="fas fa-copy"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- E-Wallet Details (Hidden initially) -->
                                <div class="card payment-details-card" id="ewalletDetails" style="display: none;">
                                    <div class="card-header gradient-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-mobile-alt mr-2"></i>
                                            <span id="ewalletTitle">Thanh toán ví điện tử</span>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="ewallet-instructions">
                                            <h6>Hướng dẫn thanh toán:</h6>
                                            <ol id="ewalletSteps">
                                                <li>Mở ứng dụng ví điện tử trên điện thoại</li>
                                                <li>Chọn "Quét mã QR" hoặc "Thanh toán QR"</li>
                                                <li>Quét mã QR bên phải để thanh toán</li>
                                                <li>Xác nhận thông tin và hoàn tất thanh toán</li>
                                            </ol>
                                        </div>
                                        
                                        <div class="payment-amount">
                                            <label>Số tiền thanh toán:</label>
                                            <div class="amount-display">
                                                <strong id="ewalletAmount">150,000đ</strong>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- QR Code Section -->
                            <div class="col-lg-6">
                                <div class="card qr-code-card">
                                    <div class="card-header gradient-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-qrcode mr-2"></i>
                                            <span id="qrTitle">QR Code chuyển khoản</span>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="qr-section">
                                            <div class="qr-container">
                                                <div class="qr-placeholder" id="qrCodeContainer">
                                                    <div class="qr-loading">
                                                        <i class="fas fa-spinner fa-spin"></i>
                                                        <p>Đang tạo mã QR...</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="qr-note">
                                                <i class="fas fa-info-circle"></i>
                                                <span id="qrNote">Quét mã QR để chuyển khoản nhanh chóng</span>
                                            </div>
                                            
                                            <!-- QR Download Button -->
                                            <div class="qr-actions" style="display: none;">
                                                <button class="btn btn-outline-primary btn-download-qr" onclick="downloadQR()">
                                                    <i class="fas fa-download mr-2"></i>
                                                    Tải xuống QR
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Upload Proof Section (Only for bank transfer) -->
                                <div class="card upload-proof-card" id="uploadSection">
                                    <div class="card-header gradient-header">
                                        <h5 class="card-title mb-0">
                                            <i class="fas fa-camera mr-2"></i>
                                            Xác nhận thanh toán
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="upload-section">
                                            <div class="upload-instructions">
                                                <h6>Hướng dẫn xác nhận:</h6>
                                                <ol>
                                                    <li>Thực hiện chuyển khoản theo thông tin bên trái</li>
                                                    <li>Chụp ảnh màn hình/biên lai chuyển khoản</li>
                                                    <li>Upload ảnh để xác nhận thanh toán</li>
                                                    <li>Đơn hàng sẽ được xác nhận sau khi kiểm tra</li>
                                                </ol>
                                            </div>

                                            <div class="upload-area" id="uploadArea">
                                                <div class="upload-content">
                                                    <i class="fas fa-cloud-upload-alt upload-icon"></i>
                                                    <h6>Tải lên ảnh chuyển khoản</h6>
                                                    <p>Kéo thả ảnh vào đây hoặc click để chọn file</p>
                                                    <p class="file-types">Hỗ trợ: JPG, PNG, PDF (tối đa 5MB)</p>
                                                </div>
                                                <input type="file" id="paymentProof" accept="image/*,.pdf" multiple>
                                            </div>

                                            <div class="uploaded-files" id="uploadedFiles" style="display: none;">
                                                <h6>Files đã upload:</h6>
                                                <div class="files-list" id="filesList"></div>
                                            </div>

                                            <div class="form-group mt-3">
                                                <label for="paymentNote">Ghi chú thêm (tùy chọn):</label>
                                                <textarea class="form-control" id="paymentNote" rows="3" 
                                                    placeholder="Thêm ghi chú về giao dịch chuyển khoản..."></textarea>
                                            </div>

                                            <div class="action-buttons">
                                                <button type="button" class="btn btn-confirm-payment" id="btnConfirmPayment" disabled>
                                                    <i class="fas fa-check mr-2"></i>
                                                    Xác nhận đã chuyển khoản
                                                </button>
                                                <button type="button" class="btn btn-back-to-order" onclick="window.history.back()">
                                                    <i class="fas fa-arrow-left mr-2"></i>
                                                    Quay lại đặt hàng
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- E-wallet Payment Actions (Hidden initially) -->
                                <div class="card ewallet-actions-card" id="ewalletActions" style="display: none;">
                                    <div class="card-body">
                                        <div class="payment-status" id="paymentStatus">
                                            <div class="status-waiting">
                                                <i class="fas fa-clock text-warning"></i>
                                                <h6>Đang chờ thanh toán</h6>
                                                <p>Vui lòng quét mã QR và hoàn tất thanh toán trong ứng dụng</p>
                                                <div class="countdown-timer">
                                                    <span id="countdown">05:00</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="action-buttons mt-3">
                                            <button type="button" class="btn btn-check-payment" id="btnCheckPayment">
                                                <i class="fas fa-sync mr-2"></i>
                                                Kiểm tra thanh toán
                                            </button>
                                            <button type="button" class="btn btn-back-to-order" onclick="window.history.back()">
                                                <i class="fas fa-arrow-left mr-2"></i>
                                                Quay lại đặt hàng
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Support Card -->
                                <div class="card support-card mt-3">
                                    <div class="card-body">
                                        <h6><i class="fas fa-headset mr-2"></i>Cần hỗ trợ?</h6>
                                        <div class="support-contacts">
                                            <div class="support-item">
                                                <i class="fas fa-phone"></i>
                                                <span>Hotline: <strong>1900-xxxx</strong></span>
                                            </div>
                                            <div class="support-item">
                                                <i class="fab fa-facebook"></i>
                                                <span>Facebook: <strong>TOOCHA TEA</strong></span>
                                            </div>
                                            <div class="support-item">
                                                <i class="fas fa-envelope"></i>
                                                <span>Email: <strong>support@toochatea.com</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- QR Code Library -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>

    <style>
        .bank-transfer-container {
            background: #f8f9fa;
            min-height: 100vh;
            padding: 20px 0;
        }

        .bank-transfer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            color: white;
            padding: 15px 0;
            margin-bottom: 20px;
        }

        .header .logo {
            color: white;
            text-decoration: none;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .header .logo:hover {
            color: white;
            text-decoration: none;
        }

        .header-title {
            text-align: center;
            flex: 1;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .gradient-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 15px 20px;
        }

        .gradient-header .card-title {
            font-weight: 600;
        }

        .card-body {
            padding: 25px;
        }

        /* Payment Method Selection Styles */
        .payment-method-card {
            margin-bottom: 25px;
        }

        .payment-methods-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .payment-method-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
            position: relative;
        }

        .payment-method-item:hover {
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }

        .payment-method-item.active {
            border-color: #667eea;
            background: linear-gradient(135deg, #f8f9ff, #e8f2ff);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .payment-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1.5rem;
            color: white;
        }

        .bank-icon {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .momo-icon {
            background: linear-gradient(135deg, #d63384, #e91e63);
        }

        .zalopay-icon {
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        }

        .vnpay-icon {
            background: linear-gradient(135deg, #fd7e14, #ffc107);
        }

        .payment-info {
            flex: 1;
        }

        .payment-info h6 {
            margin: 0 0 4px 0;
            font-weight: 600;
            color: #333;
            font-size: 1rem;
        }

        .payment-info small {
            color: #666;
            font-size: 0.85rem;
        }

        .payment-badge {
            position: absolute;
            top: -5px;
            right: -5px;
        }

        .payment-badge .badge {
            font-size: 0.7rem;
            padding: 4px 8px;
        }

        /* Order Summary Styles */
        .order-summary-card {
            margin-bottom: 25px;
        }

        .order-info {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
        }

        .order-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }

        .order-row:last-child {
            border-bottom: none;
        }

        .order-row.total-row {
            background: linear-gradient(135deg, #ffa726, #ff9800);
            color: white;
            margin: 10px -10px -10px -10px;
            padding: 15px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .order-label {
            font-weight: 500;
            color: #555;
        }

        .order-value {
            font-weight: 600;
            color: #333;
        }

        .order-id {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 0.9rem;
        }

        .total-amount {
            font-size: 1.2rem;
            color: white !important;
        }

        /* Payment Method Selection Styles */
        .payment-method-card {
            margin-bottom: 25px;
        }

        .payment-methods-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .payment-method-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border: 2px solid #e9ecef;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
            position: relative;
        }

        .payment-method-item:hover {
            border-color: #667eea;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }

        .payment-method-item.active {
            border-color: #667eea;
            background: linear-gradient(135deg, #f8f9ff, #e8f2ff);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .payment-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-size: 1.5rem;
            color: white;
        }

        .bank-icon {
            background: linear-gradient(135deg, #667eea, #764ba2);
        }

        .momo-icon {
            background: linear-gradient(135deg, #d63384, #e91e63);
        }

        .zalopay-icon {
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
        }

        .vnpay-icon {
            background: linear-gradient(135deg, #fd7e14, #ffc107);
        }

        .payment-info {
            flex: 1;
        }

        .payment-info h6 {
            margin: 0 0 4px 0;
            font-weight: 600;
            color: #333;
            font-size: 1rem;
        }

        .payment-info small {
            color: #666;
            font-size: 0.85rem;
        }

        .payment-badge {
            position: absolute;
            top: -5px;
            right: -5px;
        }

        .payment-badge .badge {
            font-size: 0.7rem;
            padding: 4px 8px;
        }

        /* Payment Details Cards */
        .payment-details-card {
            transition: all 0.3s ease;
        }

        .ewallet-instructions {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .ewallet-instructions h6 {
            color: #1976d2;
            margin-bottom: 10px;
        }

        .ewallet-instructions ol {
            margin: 0;
            padding-left: 20px;
        }

        .ewallet-instructions li {
            color: #333;
            margin-bottom: 5px;
        }

        .payment-amount {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .amount-display {
            margin-top: 10px;
        }

        .amount-display strong {
            font-size: 1.8rem;
            color: #28a745;
            font-weight: 700;
        }

        /* E-wallet Actions Styles */
        .payment-status {
            text-align: center;
            padding: 20px;
            background: #fff3cd;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .status-waiting {
            color: #856404;
        }

        .status-waiting i {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .status-waiting h6 {
            margin: 10px 0;
            font-weight: 600;
        }

        .countdown-timer {
            margin-top: 15px;
            padding: 10px;
