<script>
function showUpdateStatusModal(orderId, currentStatus) {
    $('#orderId').val(orderId);
    
    // Load available status options
    var statusOptions = getAvailableStatuses(currentStatus);
    var selectHtml = '';
    statusOptions.forEach(function(status) {
        selectHtml += `<option value="${status.value}">${status.text}</option>`;
    });
    $('#newStatus').html(selectHtml);
    
    $('#updateStatusModal').modal('show');
}

function getAvailableStatuses(currentStatus) {
    var statuses = [];
    
    switch(currentStatus) {
        case 'Pending':
            statuses.push({value: 'Processing', text: 'Đang xử lý'});
            statuses.push({value: 'Cancelled', text: 'Hủy đơn hàng'});
            break;
        case 'Processing':
            statuses.push({value: 'Shipped', text: 'Đã giao vận'});
            statuses.push({value: 'Cancelled', text: 'Hủy đơn hàng'});
            break;
        case 'Shipped':
            statuses.push({value: 'Delivered', text: 'Đã giao thành công'});
            statuses.push({value: 'Failed', text: 'Giao hàng thất bại'});
            break;
        case 'Failed':
            statuses.push({value: 'Processing', text: 'Xử lý lại'});
            break;
    }
    
    return statuses;
}

function updateOrderStatus() {
    var orderId = $('#orderId').val();
    var newStatus = $('#newStatus').val();
    
    if (!newStatus) {
        alert('Vui lòng chọn trạng thái mới');
        return;
    }
    
    $.post('@Url.Action("UpdateOrderStatus")', {
        orderId: orderId,
        newStatus: newStatus
    }, function(response) {
        if (response.success) {
            alert('Cập nhật trạng thái thành công!');
            location.reload();
        } else {
            alert('Lỗi: ' + response.message);
        }
    });
}
</script> 