@model App.Models.Toocha.Order
@using App.Models.Toocha

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id.ToString("D6")}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3><i class="fas fa-file-invoice mr-2"></i>Chi tiết đơn hàng #@Model.Id.ToString("D6")</h3>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="@Url.Action("OrderManagement")">Quản lý đơn hàng</a>
                            </li>
                            <li class="breadcrumb-item active">Chi tiết đơn hàng</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <a href="@Url.Action("OrderManagement")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i>Quay lại
                    </a>
                    @if (CanUpdateStatus(Model.Status))
                    {
                        <button type="button" class="btn btn-primary" onclick="showUpdateStatusModal(@Model.Id, '@Model.Status')">
                            <i class="fas fa-edit mr-1"></i>Cập nhật trạng thái
                        </button>
                    }
                </div>
            </div>

            <div class="row">
                <!-- Thông tin đơn hàng -->
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="fas fa-shopping-cart mr-2"></i>Thông tin đơn hàng</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Mã đơn hàng:</strong></td>
                                            <td>#@Model.Id.ToString("D6")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Ngày đặt:</strong></td>
                                            <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Trạng thái:</strong></td>
                                            <td>
                                                <span class="badge @GetStatusBadgeClass(Model.Status) badge-lg">
                                                    @GetStatusText(Model.Status)
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Phương thức thanh toán:</strong></td>
                                            <td>@Model.PaymentMethod</td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-borderless">
                                        <tr>
                                            <td><strong>Trạng thái thanh toán:</strong></td>
                                            <td>
                                                <span class="badge @(Model.IsPaid ? "badge-success" : "badge-warning") badge-lg">
                                                    @(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
                                                </span>
                                            </td>
                                        </tr>
                                        @if (!string.IsNullOrEmpty(Model.TransactionId))
                                        {
                                            <tr>
                                                <td><strong>Mã giao dịch:</strong></td>
                                                <td>@Model.TransactionId</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td><strong>Tổng tiền:</strong></td>
                                            <td><strong class="text-success fs-5">@Model.TotalPrice.ToString("N0")đ</strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Chi tiết sản phẩm -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="fas fa-list mr-2"></i>Chi tiết sản phẩm</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Tùy chọn</th>
                                            <th>Số lượng</th>
                                            <th>Đơn giá</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.OrderItems)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(item.Product?.Image))
                                                        {
                                                            <img src="@item.Product.Image" alt="@item.Product.Name" 
                                                                 class="product-thumb mr-3">
                                                        }
                                                        <div>
                                                            <strong>@item.Product?.Name</strong>
                                                            @if (!string.IsNullOrEmpty(item.Notes))
                                                            {
                                                                <br><small class="text-muted">@item.Notes</small>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="product-options">
                                                        <div><strong>Đường:</strong> @item.SugarPercentage%</div>
                                                        <div><strong>Đá:</strong> @item.IcePercentage%</div>
                                                        @if (item.OrderItemToppings.Any())
                                                        {
                                                            <div><strong>Topping:</strong></div>
                                                            @foreach (var topping in item.OrderItemToppings)
                                                            {
                                                                <small class="badge badge-secondary mr-1">@topping.Topping?.Name</small>
                                                            }
                                                        }
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge badge-primary badge-pill">@item.Quantity</span>
                                                </td>
                                                <td>@((item.ItemPrice / item.Quantity).ToString("N0"))đ</td>
                                                <td><strong>@item.ItemPrice.ToString("N0")đ</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr>
                                            <td colspan="4" class="text-right"><strong>Tổng cộng:</strong></td>
                                            <td><strong class="text-success">@Model.TotalPrice.ToString("N0")đ</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thông tin khách hàng -->
                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5><i class="fas fa-user mr-2"></i>Thông tin khách hàng</h5>
                        </div>
                        <div class="card-body">
                            <div class="customer-info">
                                <div class="info-item">
                                    <i class="fas fa-user text-muted"></i>
                                    <div>
                                        <label>Tên khách hàng:</label>
                                        <div>@(Model.User?.UserName ?? "Khách vãng lai")</div>
                                    </div>
                                </div>
                                
                                <div class="info-item">
                                    <i class="fas fa-phone text-muted"></i>
                                    <div>
                                        <label>Số điện thoại:</label>
                                        <div>
                                            <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                                        </div>
                                    </div>
                                </div>

                                @if (Model.User?.Email != null)
                                {
                                    <div class="info-item">
                                        <i class="fas fa-envelope text-muted"></i>
                                        <div>
                                            <label>Email:</label>
                                            <div>
                                                <a href="mailto:@Model.User.Email">@Model.User.Email</a>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="info-item">
                                    <i class="fas fa-map-marker-alt text-muted"></i>
                                    <div>
                                        <label>Địa chỉ giao hàng:</label>
                                        <div>@Model.ShippingAddress</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline trạng thái -->
                    <div class="card">
                        <div class="card-header">
                            <h5><i class="fas fa-history mr-2"></i>Lịch sử trạng thái</h5>
                        </div>
                        <div class="card-body">
                            <div class="timeline">
                                <div class="timeline-item @(Model.Status >= OrderStatus.Pending ? "active" : "")">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đơn hàng được tạo</div>
                                        <div class="timeline-time">@Model.OrderDate.ToString("dd/MM HH:mm")</div>
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(Model.Status >= OrderStatus.Processing ? "active" : "")">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đang xử lý</div>
                                        @if (Model.Status >= OrderStatus.Processing)
                                        {
                                            <div class="timeline-time">Đã xác nhận</div>
                                        }
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(Model.Status >= OrderStatus.Shipped ? "active" : "")">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đã giao vận</div>
                                        @if (Model.Status >= OrderStatus.Shipped)
                                        {
                                            <div class="timeline-time">Đang vận chuyển</div>
                                        }
                                    </div>
                                </div>
                                
                                <div class="timeline-item @(Model.Status >= OrderStatus.Delivered ? "active" : "")">
                                    <div class="timeline-marker"></div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">Đã giao hàng</div>
                                        @if (Model.Status >= OrderStatus.Delivered)
                                        {
                                            <div class="timeline-time">Hoàn thành</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal cập nhật trạng thái -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật trạng thái đơn hàng</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="updateStatusForm">
                    <input type="hidden" id="orderId" />
                    <div class="form-group">
                        <label for="newStatus">Trạng thái mới:</label>
                        <select id="newStatus" class="form-control">
                            <!-- Options sẽ được load bằng JavaScript -->
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="updateOrderStatus()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetStatusText(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "Chờ xử lý",
            OrderStatus.Processing => "Đang xử lý",
            OrderStatus.Shipped => "Đã giao vận",
            OrderStatus.Delivered => "Đã giao",
            OrderStatus.Cancelled => "Đã hủy",
            OrderStatus.Failed => "Thất bại",
            _ => status.ToString()
        };
    }

    private string GetStatusBadgeClass(OrderStatus status)
    {
        return status switch
        {
            OrderStatus.Pending => "badge-warning",
            OrderStatus.Processing => "badge-info",
            OrderStatus.Shipped => "badge-primary",
            OrderStatus.Delivered => "badge-success",
            OrderStatus.Cancelled => "badge-danger",
            OrderStatus.Failed => "badge-dark",
            _ => "badge-secondary"
        };
    }

    private bool CanUpdateStatus(OrderStatus status)
    {
        return status != OrderStatus.Delivered && status != OrderStatus.Cancelled;
    }
}

