@model IEnumerable<App.Models.Toocha.Order>
@{
    ViewData["Title"] = "Lịch sử đơn hàng";
}

<div class="order-history-page">
    <!-- Header Section -->
    <div class="page-header">
        <div class="container">
            <div class="header-content">
                <div class="header-icon">
                    <i class="fas fa-history"></i>
                </div>
                <div class="header-text">
                    <h1>Lịch sử đơn hàng</h1>
                    <p>Theo dõi tất cả đơn hàng của bạn</p>
                </div>
            </div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Member/Index"><i class="fas fa-home"></i> Tài khoản</a></li>
                    <li class="breadcrumb-item active">Lịch sử đơn hàng</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container mt-5">
        @if (!Model.Any())
        {
            <!-- Empty State -->
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <h3>Chưa có đơn hàng nào</h3>
                <p>Bạn chưa đặt đơn hàng nào. Hãy khám phá menu tuyệt vời của TooCha!</p>
                <a href="/Toocha/Order" class="btn btn-primary btn-lg">
                    <i class="fas fa-utensils"></i> Đặt hàng ngay
                </a>
            </div>
        }
        else
        {
            <!-- Statistics Cards -->
            <div class="stats-section mb-5">
                <div class="row">
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="stats-card">
                            <div class="stats-icon">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                            <div class="stats-content">
                                <h3>@Model.Count()</h3>
                                <p>Tổng đơn hàng</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="stats-card">
                            <div class="stats-icon">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                            <div class="stats-content">
                                <h3>@Model.Sum(o => o.TotalPrice).ToString("N0")đ</h3>
                                <p>Tổng chi tiêu</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="stats-card">
                            <div class="stats-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stats-content">
                                <h3>@Model.Count(o => o.Status == App.Models.Toocha.OrderStatus.Delivered)</h3>
                                <p>Đã hoàn thành</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Orders List -->
            <div class="orders-section">
                <div class="section-header">
                    <h2><i class="fas fa-list-alt"></i> Đơn hàng của bạn</h2>
                    <p>Xem chi tiết tất cả đơn hàng đã đặt</p>
                </div>
                
                @foreach (var order in Model)
                {
                    <div class="order-card">
                        <!-- Order Header -->
                        <div class="order-header">
                            <div class="order-info">
                                <div class="order-number">
                                    <h4>Đơn hàng #@order.Id</h4>
                                    <span class="order-date">
                                        <i class="fas fa-calendar-alt"></i> 
                                        @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>
                                <div class="order-status-wrapper">
                                    <span class="order-status status-@order.Status.ToString().ToLower()">
                                        @switch (order.Status)
                                        {
                                            case App.Models.Toocha.OrderStatus.Pending:
                                                <text><i class="fas fa-clock"></i> Chờ xác nhận</text>
                                                break;
                                            case App.Models.Toocha.OrderStatus.Processing:
                                                <text><i class="fas fa-cog"></i> Đang xử lý</text>
                                                break;
                                            case App.Models.Toocha.OrderStatus.Shipped:
                                                <text><i class="fas fa-shipping-fast"></i> Đang giao</text>
                                                break;
                                            case App.Models.Toocha.OrderStatus.Delivered:
                                                <text><i class="fas fa-check-circle"></i> Hoàn thành</text>
                                                break;
                                            case App.Models.Toocha.OrderStatus.Cancelled:
                                                <text><i class="fas fa-times-circle"></i> Đã hủy</text>
                                                break;
                                            case App.Models.Toocha.OrderStatus.Failed:
                                                <text><i class="fas fa-exclamation-triangle"></i> Thất bại</text>
                                                break;
                                        }
                                    </span>
                                    <div class="order-total">
                                        <span class="total-label">Tổng tiền:</span>
                                        <span class="total-amount">@order.TotalPrice.ToString("N0")đ</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Content -->
                        <div class="order-body">
                            <!-- Products -->
                            <div class="products-section">
                                <h5><i class="fas fa-utensils"></i> Sản phẩm đã đặt</h5>
                                <div class="products-list">
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <div class="product-item">
                                            <div class="product-main">
                                                <div class="product-info">
                                                    <h6>@item.Product.Name</h6>
                                                    <div class="product-details">
                                                        <span class="quantity">Số lượng: @item.Quantity</span>
                                                        @if (item.SugarPercentage != 100 || item.IcePercentage != 100)
                                                        {
                                                            <span class="customization">
                                                                Đường: @item.SugarPercentage% • Đá: @item.IcePercentage%
                                                            </span>
                                                        }
                                                    </div>
                                                    @if (item.OrderItemToppings.Any())
                                                    {
                                                        <div class="toppings">
                                                            <span class="toppings-label">Topping:</span>
                                                            <span class="toppings-list">@string.Join(", ", item.OrderItemToppings.Select(t => t.Topping.Name))</span>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="product-price">
                                                    <span>@item.ItemPrice.ToString("N0")đ</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Order Details -->
                            <div class="order-details-section">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="detail-group">
                                            <h6><i class="fas fa-map-marker-alt"></i> Thông tin giao hàng</h6>
                                            <div class="detail-item">
                                                <span class="detail-label">Địa chỉ:</span>
                                                <span class="detail-value">@order.ShippingAddress</span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">SĐT:</span>
                                                <span class="detail-value">@order.PhoneNumber</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-group">
                                            <h6><i class="fas fa-credit-card"></i> Thông tin thanh toán</h6>
                                            <div class="detail-item">
                                                <span class="detail-label">Phương thức:</span>
                                                <span class="detail-value">
                                                    @if (order.PaymentMethod == "cash")
                                                    {
                                                        <text><i class="fas fa-money-bill-wave"></i> Tiền mặt</text>
                                                    }
                                                    else
                                                    {
                                                        <text><i class="fas fa-university"></i> Chuyển khoản</text>
                                                    }
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <span class="detail-label">Trạng thái:</span>
                                                <span class="detail-value @(order.IsPaid ? "paid" : "unpaid")">
                                                    @if (order.IsPaid)
                                                    {
                                                        <text><i class="fas fa-check-circle"></i> Đã thanh toán</text>
                                                    }
                                                    else
                                                    {
                                                        <text><i class="fas fa-clock"></i> Chưa thanh toán</text>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="order-actions">
                                @if (order.Status == App.Models.Toocha.OrderStatus.Pending)
                                {
                                    <button class="btn btn-danger" onclick="cancelOrder(@order.Id)">
                                        <i class="fas fa-times"></i> Hủy đơn
                                    </button>
                                }
                                <button class="btn btn-outline-primary">
                                    <i class="fas fa-print"></i> In hóa đơn
                                </button>
                                <button class="btn btn-outline-secondary">
                                    <i class="fas fa-eye"></i> Xem chi tiết
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .order-history-page {
        background: #f8f9fa; /* Light gray background */
        min-height: 100vh;
        padding-bottom: 1.5rem;
    }

    .page-header {
        background: #e9ecef; /* Lighter header */
        color: #343a40;
        padding: 1.5rem 0 1rem;
        position: relative;
        overflow: hidden;
        border-bottom: 1px solid #dee2e6;
    }

    .page-header::before {
        content: none;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 0.6rem;
        position: relative;
        z-index: 1;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        background: #007bff; /* Primary color icon */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        /* Removed backdrop-filter */
    }

    .header-text h1 {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 600;
        text-shadow: none;
    }

    .header-text p {
        margin: 0.2rem 0 0;
        font-size: 0.9rem;
        opacity: 0.8;
    }

    .breadcrumb {
        background: transparent;
        margin: 0;
        padding: 0;
        position: relative;
        z-index: 1;
        font-size: 0.8rem;
    }

    .breadcrumb-item a {
        color: #6c757d;
        text-decoration: none;
        transition: color 0.2s;
    }

    .breadcrumb-item a:hover {
        color: #495057;
    }

    .breadcrumb-item.active {
        color: #495057;
    }

    .empty-state {
        background: white;
        padding: 2.5rem 1rem;
        border-radius: 8px;
        box-shadow: none; /* Removed shadow */
        text-align: center;
        margin-top: 1.5rem;
        border: 1px dashed #dee2e6; /* Dashed border for empty state */
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        background: #6c757d; /* Gray for empty icon */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 2rem;
        color: white;
    }

    .empty-state h3 {
        color: #343a40;
        margin-bottom: 0.6rem;
        font-size: 1.3rem;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 0.9rem;
        margin-bottom: 1.2rem;
    }

    .stats-section {
        margin-bottom: 1.5rem;
    }

    .stats-card {
        background: white;
        border-radius: 8px;
        padding: 1.2rem;
        box-shadow: none; /* Removed shadow */
        display: flex;
        align-items: center;
        gap: 0.8rem;
        transition: all 0.15s ease-out; /* Subtle transition */
        border: 1px solid #e9ecef;
    }

    .stats-card:hover {
        transform: none; /* Removed hover transform */
        box-shadow: 0 2px 8px rgba(0,0,0,0.05); /* Very subtle shadow on hover */
    }

    .stats-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: white;
        background: #17a2b8; /* Info color */
    }

    .stats-content h3 {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 600;
        color: #343a40;
    }

    .stats-content p {
        margin: 0.2rem 0 0;
        color: #6c757d;
        font-size: 0.8rem;
        font-weight: 400;
    }

    .section-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .section-header h2 {
        color: #343a40;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .section-header p {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .order-card {
        background: white;
        border-radius: 8px;
        box-shadow: none; /* Removed shadow */
        margin-bottom: 1rem;
        overflow: hidden;
        transition: all 0.15s ease-out; /* Subtle transition */
        border: 1px solid #e9ecef;
    }

    .order-card:hover {
        transform: none; /* Removed hover transform */
        box-shadow: 0 2px 8px rgba(0,0,0,0.05); /* Very subtle shadow on hover */
    }

    .order-header {
        background: #f8f9fa;
        padding: 1.2rem;
        border-bottom: 1px solid #dee2e6;
    }

    .order-info {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .order-number h4 {
        margin: 0 0 0.3rem;
        color: #343a40;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .order-date {
        color: #6c757d;
        font-size: 0.8rem;
    }

    .order-status-wrapper {
        text-align: right;
    }

    .order-status {
        display: inline-block;
        padding: 0.4rem 0.8rem;
        border-radius: 16px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 0.6rem;
    }

    .status-pending { background: #fff3cd; color: #856404; }
    .status-processing { background: #cce5ff; color: #004085; }
    .status-shipped { background: #e2e3e5; color: #383d41; }
    .status-delivered { background: #d4edda; color: #155724; }
    .status-cancelled { background: #f8d7da; color: #721c24; }
    .status-failed { background: #f5c6cb; color: #721c24; }

    .order-total {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .total-label {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .total-amount {
        font-size: 1.2rem;
        font-weight: 700;
        color: #28a745;
    }

    .order-body {
        padding: 1.2rem;
    }

    .products-section {
        margin-bottom: 1.2rem;
    }

    .products-section h5 {
        color: #343a40;
        margin-bottom: 0.8rem;
        font-weight: 600;
        font-size: 1rem;
    }

    .products-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .product-item {
        background: #ffffff;
        border-radius: 6px;
        padding: 0.8rem;
        border: 1px solid #e9ecef;
    }

    .product-main {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.6rem;
    }

    .product-info h6 {
        margin: 0 0 0.3rem;
        color: #343a40;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .product-details {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        margin-bottom: 0.3rem;
        font-size: 0.8rem;
    }

    .quantity, .customization {
        font-size: 0.8rem;
        color: #6c757d;
    }

    .toppings {
        margin-top: 0.3rem;
    }

    .toppings-label {
        font-size: 0.75rem;
        color: #6c757d;
        font-weight: 500;
    }

    .toppings-list {
        font-size: 0.75rem;
        color: #495057;
        font-weight: 600;
    }

    .product-price {
        font-size: 0.9rem;
        font-weight: 600;
        color: #28a745;
        white-space: nowrap;
    }

    .order-details-section {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1.2rem;
        margin-bottom: 1.2rem;
        border: 1px solid #e9ecef;
    }

    .detail-group h6 {
        color: #343a40;
        margin-bottom: 0.6rem;
        font-weight: 600;
        font-size: 1rem;
    }

    .detail-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
        padding: 0.3rem 0;
        border-bottom: 1px dashed #e9ecef;
        font-size: 0.85rem;
    }

    .detail-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .detail-label {
        font-weight: 500;
        color: #6c757d;
    }

    .detail-value {
        font-weight: 600;
        color: #343a40;
    }

    .detail-value.paid {
        color: #28a745;
    }

    .detail-value.unpaid {
        color: #ffc107;
    }

    .order-actions {
        display: flex;
        gap: 0.6rem;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 16px;
        font-weight: 600;
        transition: all 0.15s ease-out;
        border: none;
        font-size: 0.85rem;
    }

    .btn-primary {
        background: #007bff;
        color: white;
    }

    .btn-primary:hover {
        transform: none;
        box-shadow: none;
        background: #0069d9;
    }

    .btn-danger {
        background: #dc3545;
        color: white;
    }

    .btn-danger:hover {
        transform: none;
        box-shadow: none;
        background: #c82333;
    }

    .btn-outline-primary {
        border: 1px solid #007bff;
        color: #007bff;
        background: transparent;
    }

    .btn-outline-primary:hover {
        background: #007bff;
        color: white;
        transform: none;
        box-shadow: none;
    }

    .btn-outline-secondary {
        border: 1px solid #6c757d;
        color: #6c757d;
        background: transparent;
    }

    .btn-outline-secondary:hover {
        background: #6c757d;
        color: white;
        transform: none;
        box-shadow: none;
    }

    @@media (max-width: 768px) {
        .header-content {
            flex-direction: column;
            text-align: center;
        }

        .header-text h1 {
            font-size: 1.6rem;
        }

        .order-info {
            flex-direction: column;
            align-items: flex-start;
        }

        .order-status-wrapper {
            text-align: left;
        }

        .product-main {
            flex-direction: column;
            align-items: flex-start;
        }

        .product-price {
            align-self: flex-end;
        }

        .order-actions {
            justify-content: center;
        }

        .stats-card {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

@section Scripts {
    <script>
        function cancelOrder(orderId) {
            if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
                alert('Chức năng hủy đơn hàng đang được phát triển.');
            }
        }
    </script>
}
