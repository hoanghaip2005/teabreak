@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Danh sách bài viết</h2>
        <p class="text-muted mb-0">Quản lý tất cả bài viết trên website</p>
    </div>
    <div>
        <a href="/Admin/Article/Create" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Tạo bài viết mới
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Tất cả bài viết</h5>
    </div>
    <div class="admin-card-body">
        <div class="text-center text-muted py-5">
            <i class="fas fa-newspaper fa-3x mb-3"></i>
            <h5>Chưa có bài viết nào</h5>
            <p>Tạo bài viết đầu tiên để chia sẻ nội dung với khách hàng</p>
            <a href="/Admin/Article/Create" class="admin-btn admin-btn-primary">
                <i class="fas fa-plus me-2"></i>Tạo bài viết mới
            </a>
        </div>
    </div>
</div> 