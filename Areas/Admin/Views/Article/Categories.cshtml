@{
    ViewData["Title"] = "Danh mục bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Danh mục bài viết</h2>
        <p class="text-muted mb-0">Quản lý các danh mục phân loại bài viết</p>
    </div>
    <div>
        <a href="#" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Thêm danh mục
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Danh sách danh mục</h5>
    </div>
    <div class="admin-card-body">
        <div class="text-center text-muted py-5">
            <i class="fas fa-tags fa-3x mb-3"></i>
            <h5>Chưa có danh mục nào</h5>
            <p>Tạo danh mục đầu tiên để phân loại bài viết</p>
        </div>
    </div>
</div> 