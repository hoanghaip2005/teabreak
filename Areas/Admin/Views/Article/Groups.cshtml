@{
    ViewData["Title"] = "Nhóm bài viết";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Nhóm bài viết</h2>
        <p class="text-muted mb-0">Quản lý các nhóm bài viết theo chủ đề</p>
    </div>
    <div>
        <a href="#" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Thêm nhóm
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Danh sách nhóm</h5>
    </div>
    <div class="admin-card-body">
        <div class="text-center text-muted py-5">
            <i class="fas fa-layer-group fa-3x mb-3"></i>
            <h5>Chưa có nhóm nào</h5>
            <p>Tạo nhóm đầu tiên để tổ chức bài viết theo chủ đề</p>
        </div>
    </div>
</div> 