@model Category
@{
    ViewData["Title"] = "Thêm Danh mục mới";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Thêm Danh mục mới</h2>
                <p class="text-muted mb-0">Tạo danh mục sản phẩm mới</p>
            </div>
            <a href="/Admin/Category" class="admin-btn admin-btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-md-10">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thông tin danh mục</h5>
            </div>
            <div class="admin-card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <div class="admin-form-group">
                        <label asp-for="Name" class="admin-form-label">Tên danh mục <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control admin-form-control" placeholder="Nhập tên danh mục">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="Description" class="admin-form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control admin-form-control" rows="4" placeholder="Nhập mô tả cho danh mục (tùy chọn)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="admin-btn admin-btn-success">
                            <i class="fas fa-save me-2"></i>Lưu danh mục
                        </button>
                        <a href="/Admin/Category" class="admin-btn admin-btn-secondary">
                            <i class="fas fa-times me-2"></i>Hủy bỏ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Hướng dẫn</h5>
            </div>
            <div class="admin-card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Lưu ý:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Tên danh mục phải từ 3-255 ký tự</li>
                        <li>Tên danh mục nên rõ ràng, dễ hiểu</li>
                        <li>Mô tả giúp khách hàng hiểu rõ hơn về danh mục</li>
                        <li>Sau khi tạo có thể chỉnh sửa bất kỳ lúc nào</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 