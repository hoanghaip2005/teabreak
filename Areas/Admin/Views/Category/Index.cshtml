@model IEnumerable<Category>
@{
    ViewData["Title"] = "Quản lý Danh mục";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Quản lý Danh mục</h2>
                <p class="text-muted mb-0">Quản lý các danh mục sản phẩm</p>
            </div>
            <a href="/Admin/Category/Create" class="admin-btn admin-btn-success">
                <i class="fas fa-plus me-2"></i>Thêm danh mục mới
            </a>
        </div>
    </div>
</div>

<!-- Search and Filter -->
<div class="row mb-4">
    <div class="col-md-6">
        <form method="get" class="d-flex">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="Tìm kiếm danh mục...">
            <button type="submit" class="admin-btn admin-btn-primary">
                <i class="fas fa-search"></i>
            </button>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <span class="text-muted">Tổng: <strong>@ViewBag.TotalItems</strong> danh mục</span>
    </div>
</div>

<!-- Categories Table -->
<div class="admin-table">
    <table class="table table-hover">
        <thead>
            <tr>
                <th style="width: 60px;">#</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th style="width: 120px;">Số sản phẩm</th>
                <th style="width: 150px;">Ngày tạo</th>
                <th style="width: 120px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Id</td>
                        <td>
                            <strong>@category.Name</strong>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <span>@(category.Description.Length > 100 ? category.Description.Substring(0, 100) + "..." : category.Description)</span>
                            }
                            else
                            {
                                <span class="text-muted">Chưa có mô tả</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary">@category.Products?.Count ?? 0</span>
                        </td>
                        <td>
                            <small class="text-muted">@category.CreatedAt.ToString("dd/MM/yyyy")</small>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a href="/Admin/Category/Details/@category.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Admin/Category/Edit/@category.Id" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Admin/Category/Delete/@category.Id" class="btn btn-sm btn-outline-danger btn-delete" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">
                        <div class="text-muted">
                            <i class="fas fa-inbox fa-3x mb-3"></i>
                            <p>Chưa có danh mục nào</p>
                            <a href="/Admin/Category/Create" class="admin-btn admin-btn-primary">
                                <i class="fas fa-plus me-2"></i>Tạo danh mục đầu tiên
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage - 1)@(string.IsNullOrEmpty(ViewBag.Search) ? "" : "&search=" + ViewBag.Search)">Trước</a>
                </li>
            }

            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i@(string.IsNullOrEmpty(ViewBag.Search) ? "" : "&search=" + ViewBag.Search)">@i</a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="?page=@(ViewBag.CurrentPage + 1)@(string.IsNullOrEmpty(ViewBag.Search) ? "" : "&search=" + ViewBag.Search)">Sau</a>
                </li>
            }
        </ul>
    </nav>
} 