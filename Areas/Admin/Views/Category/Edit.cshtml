@model Category
@{
    ViewData["Title"] = "Chỉnh sửa Danh mục";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Chỉnh sửa Danh mục</h2>
                <p class="text-muted mb-0">Cập nhật thông tin danh mục sản phẩm</p>
            </div>
            <a href="/Admin/Category" class="admin-btn admin-btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-md-10">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thông tin danh mục</h5>
            </div>
            <div class="admin-card-body">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="CreatedAt" type="hidden" />
                    
                    <div class="admin-form-group">
                        <label asp-for="Name" class="admin-form-label">Tên danh mục <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control admin-form-control" placeholder="Nhập tên danh mục">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="admin-form-group">
                        <label asp-for="Description" class="admin-form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control admin-form-control" rows="4" placeholder="Nhập mô tả cho danh mục (tùy chọn)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="admin-form-group">
                                <label class="admin-form-label">Ngày tạo</label>
                                <input value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")" class="form-control admin-form-control" readonly>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="admin-form-group">
                                <label class="admin-form-label">Cập nhật lần cuối</label>
                                <input value="@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")" class="form-control admin-form-control" readonly>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="admin-btn admin-btn-success">
                            <i class="fas fa-save me-2"></i>Cập nhật danh mục
                        </button>
                        <a href="/Admin/Category" class="admin-btn admin-btn-secondary">
                            <i class="fas fa-times me-2"></i>Hủy bỏ
                        </a>
                        <a href="/Admin/Category/Details/@Model.Id" class="admin-btn admin-btn-info">
                            <i class="fas fa-eye me-2"></i>Xem chi tiết
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thông tin tóm tắt</h5>
            </div>
            <div class="admin-card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h4 class="text-primary">@(Model.Products?.Count ?? 0)</h4>
                            <small class="text-muted">Sản phẩm</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h4 class="text-success">@Model.Id</h4>
                        <small class="text-muted">ID Danh mục</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-card mt-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Hướng dẫn</h5>
            </div>
            <div class="admin-card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>Lưu ý:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Thay đổi tên danh mục sẽ ảnh hưởng đến hiển thị</li>
                        <li>Không thể xóa danh mục đang có sản phẩm</li>
                        <li>Mô tả giúp khách hàng hiểu rõ hơn</li>
                        <li>Thời gian tạo và cập nhật được tự động ghi nhận</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 