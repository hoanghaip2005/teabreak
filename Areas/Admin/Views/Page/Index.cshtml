@{
    ViewData["Title"] = "Quản lý Trang";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý Trang</h2>
        <p class="text-muted mb-0">Quản lý các trang tĩnh trên website</p>
    </div>
    <div>
        <a href="/Admin/Page/Create" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Tạo trang mới
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Danh sách trang</h5>
    </div>
    <div class="admin-card-body">
        <div class="text-center text-muted py-5">
            <i class="fas fa-file-alt fa-3x mb-3"></i>
            <h5>Chưa có trang nào</h5>
            <p>Tạo trang đầu tiên để hiển thị nội dung tĩnh</p>
            <a href="/Admin/Page/Create" class="admin-btn admin-btn-primary">
                <i class="fas fa-plus me-2"></i>Tạo trang mới
            </a>
        </div>
    </div>
</div> 