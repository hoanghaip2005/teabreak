@model App.Areas.Admin.Controllers.BestSellingReportViewModel

@{
    ViewData["Title"] = "Sản phẩm bán chạy";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-trophy"></i>
                        Sản phẩm bán chạy
                    </h3>
                </div>
                <div class="card-body">
                    <!-- Date Filter -->
                    <form method="get" class="mb-4">
                        <div class="row">
                            <div class="col-md-3">
                                <label>Từ ngày:</label>
                                <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label>Đến ngày:</label>
                                <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Xem báo cáo
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Best Selling Products -->
                    @if (Model.BestSellingProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Hạng</th>
                                        <th>Sản phẩm</th>
                                        <th>Số lượng bán</th>
                                        <th>Doanh thu</th>
                                        <th>Số đơn hàng</th>
                                        <th>Giá trung bình</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.BestSellingProducts.Count; i++)
                                    {
                                        var product = Model.BestSellingProducts[i];
                                        <tr>
                                            <td style="width: 60px;">
                                                @if (i == 0)
                                                {
                                                    <span class="badge badge-warning" style="font-size: 1.1em;">
                                                        <i class="fas fa-trophy"></i> 1
                                                    </span>
                                                }
                                                else if (i == 1)
                                                {
                                                    <span class="badge badge-secondary" style="font-size: 1.0em;">
                                                        <i class="fas fa-medal"></i> 2
                                                    </span>
                                                }
                                                else if (i == 2)
                                                {
                                                    <span class="badge badge-info" style="font-size: 1.0em;">
                                                        <i class="fas fa-award"></i> 3
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light text-dark">@(i + 1)</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(product.ProductImage))
                                                    {
                                                        <img src="@product.ProductImage" alt="@product.ProductName" 
                                                             class="rounded me-2" style="width: 40px; height: 40px; object-fit: cover;">
                                                    }
                                                    else
                                                    {
                                                        <div class="bg-light rounded me-2 d-flex align-items-center justify-content-center" 
                                                             style="width: 40px; height: 40px;">
                                                            <i class="fas fa-image text-muted"></i>
                                                        </div>
                                                    }
                                                    <strong>@product.ProductName</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-success" style="font-size: 1.0em;">
                                                    @product.TotalQuantity
                                                </span>
                                            </td>
                                            <td>
                                                <strong class="text-success">@product.TotalRevenue.ToString("N0") VNĐ</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-info">@product.OrderCount</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@((product.TotalRevenue / product.TotalQuantity).ToString("N0")) VNĐ</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Summary Stats -->
                        <div class="row mt-4">
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h5>Tổng sản phẩm bán chạy</h5>
                                        <h3 class="text-primary">@Model.BestSellingProducts.Count</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h5>Tổng số lượng bán</h5>
                                        <h3 class="text-success">@Model.BestSellingProducts.Sum(p => p.TotalQuantity)</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h5>Tông doanh thu</h5>
                                        <h3 class="text-warning">@Model.BestSellingProducts.Sum(p => p.TotalRevenue).ToString("N0") VNĐ</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <i class="fas fa-chart-bar fa-5x text-muted mb-3"></i>
                            <h4 class="text-muted">Không có dữ liệu</h4>
                            <p class="text-muted">Không có sản phẩm nào được bán trong khoảng thời gian này</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 