@{
    ViewData["Title"] = "Quản lý Redirect";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý Redirect</h2>
        <p class="text-muted mb-0">Quản lý các đường dẫn chuyển hướng</p>
    </div>
    <div>
        <a href="/Admin/Redirect/Create" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Tạo redirect mới
        </a>
    </div>
</div>

<div class="admin-card">
