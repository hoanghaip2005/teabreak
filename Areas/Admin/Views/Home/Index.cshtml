@model DashboardStats
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Chào mừng trở lại!</h2>
                <p class="text-muted mb-0">Tổng quan hoạt động kinh doanh hôm nay</p>
            </div>
            <div class="text-end">
                <small class="text-muted">Cập nhật lúc: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</small>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid">
    <div class="stats-card">
        <div class="stats-icon primary">
            <i class="fas fa-box"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalProducts</h3>
            <p>Tổng sản phẩm</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalOrders</h3>
            <p>Tổng đơn hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon warning">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TodayOrders</h3>
            <p>Đơn hàng hôm nay</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon danger">
            <i class="fas fa-hourglass-half"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.PendingOrders</h3>
            <p>Đơn chờ xử lý</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-store"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalStores</h3>
            <p>Tổng cửa hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon primary">
            <i class="fas fa-users"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalUsers</h3>
            <p>Tổng khách hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon warning">
            <i class="fas fa-tags"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalCategories</h3>
            <p>Danh mục sản phẩm</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-currency">@Model.TotalRevenue</h3>
            <p>Tổng doanh thu</p>
        </div>
    </div>
</div>

<!-- Charts and Tables -->
<div class="row">
    <!-- Revenue Chart -->
    <div class="col-lg-8 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Doanh thu 7 ngày qua</h5>
            </div>
            <div class="admin-card-body">
                <canvas id="revenueChart" style="height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Order Status Chart -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Trạng thái đơn hàng</h5>
            </div>
            <div class="admin-card-body">
                <canvas id="orderStatusChart" style="height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-lg-8 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="admin-card-title">Đơn hàng gần đây</h5>
                <a href="/Admin/Order" class="admin-btn admin-btn-primary admin-btn-sm">
                    <i class="fas fa-eye me-1"></i> Xem tất cả
                </a>
            </div>
            <div class="admin-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>#001</strong></td>
                                <td>Nguyễn Văn A</td>
                                <td class="format-currency">125000</td>
                                <td><span class="badge bg-warning">Chờ xử lý</span></td>
                                <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td><strong>#002</strong></td>
                                <td>Trần Thị B</td>
                                <td class="format-currency">89000</td>
                                <td><span class="badge bg-success">Hoàn thành</span></td>
                                <td>@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td><strong>#003</strong></td>
                                <td>Lê Văn C</td>
                                <td class="format-currency">156000</td>
                                <td><span class="badge bg-info">Đang giao</span></td>
                                <td>@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thao tác nhanh</h5>
            </div>
            <div class="admin-card-body">
                <div class="d-grid gap-2">
                    <a href="/Admin/Product/Create" class="admin-btn admin-btn-success">
                        <i class="fas fa-plus me-2"></i> Thêm sản phẩm mới
                    </a>
                    <a href="/Admin/Category/Create" class="admin-btn admin-btn-primary">
                        <i class="fas fa-tags me-2"></i> Thêm danh mục
                    </a>
                    <a href="/Admin/Store/Create" class="admin-btn admin-btn-warning">
                        <i class="fas fa-store me-2"></i> Thêm cửa hàng
                    </a>
                    <a href="/Admin/Order?status=0" class="admin-btn admin-btn-danger">
                        <i class="fas fa-clock me-2"></i> Xem đơn chờ xử lý
                    </a>
                    <hr class="my-3">
                    <h6 class="text-muted mb-2">Báo cáo</h6>
                    <a href="/Admin/Report" class="admin-btn admin-btn-info">
                        <i class="fas fa-chart-line me-2"></i> Báo cáo doanh thu
                    </a>
                    <a href="/Admin/Report/BestSelling" class="admin-btn admin-btn-secondary">
                        <i class="fas fa-trophy me-2"></i> Sản phẩm bán chạy
                    </a>
                </div>
            </div>
        </div>

        <!-- System Info -->
        <div class="admin-card mt-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thông tin hệ thống</h5>
            </div>
            <div class="admin-card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h6 class="text-success">Hoạt động</h6>
                            <small class="text-muted">Trạng thái</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h6 class="text-primary">v1.0.0</h6>
                        <small class="text-muted">Phiên bản</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Revenue Chart
    const revenueCtx = document.getElementById('revenueChart').getContext('2d');
    new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'CN'],
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: [1200000, 1900000, 800000, 1500000, 2000000, 1800000, 1600000],
                borderColor: '#3498db',
                backgroundColor: 'rgba(52, 152, 219, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });

    // Order Status Chart
    const orderStatusCtx = document.getElementById('orderStatusChart').getContext('2d');
    new Chart(orderStatusCtx, {
        type: 'doughnut',
        data: {
            labels: ['Chờ xử lý', 'Đang chuẩn bị', 'Đang giao', 'Hoàn thành', 'Đã hủy'],
            datasets: [{
                data: [@Model.PendingOrders, 15, 8, 45, 3],
                backgroundColor: [
                    '#f39c12',
                    '#3498db', 
                    '#9b59b6',
                    '#2ecc71',
                    '#e74c3c'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
});
</script>
} 