@model DashboardStats
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Chào mừng trở lại!</h2>
                <p class="text-muted mb-0">Tổng quan hoạt động kinh doanh hôm nay</p>
            </div>
            <div class="text-end">
                <small class="text-muted">Cập nhật lúc: @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</small>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="stats-grid">
    <div class="stats-card">
        <div class="stats-icon primary">
            <i class="fas fa-box"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalProducts</h3>
            <p>Tổng sản phẩm</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-shopping-cart"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalOrders</h3>
            <p>Tổng đơn hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon warning">
            <i class="fas fa-clock"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TodayOrders</h3>
            <p>Đơn hàng hôm nay</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon danger">
            <i class="fas fa-hourglass-half"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.PendingOrders</h3>
            <p>Đơn chờ xử lý</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-store"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalStores</h3>
            <p>Tổng cửa hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon primary">
            <i class="fas fa-users"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalUsers</h3>
            <p>Tổng khách hàng</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon warning">
            <i class="fas fa-tags"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-number">@Model.TotalCategories</h3>
            <p>Danh mục sản phẩm</p>
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-icon success">
            <i class="fas fa-dollar-sign"></i>
        </div>
        <div class="stats-content">
            <h3 class="format-currency">@Model.TotalRevenue</h3>
            <p>Tổng doanh thu</p>
        </div>
    </div>
</div>

<!-- Performance Comparison -->
<div class="row mb-4">
    <div class="col-12">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">So sánh hiệu suất</h5>
            </div>
            <div class="admin-card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center">
                            <h6 class="text-muted">Doanh thu hôm nay</h6>
                                                         <h4 class="text-success format-currency">@((Model.TotalRevenue * 0.1m).ToString("0"))</h4>
                            <small class="text-success"><i class="fas fa-arrow-up"></i> +12% so với hôm qua</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h6 class="text-muted">Đơn hàng hôm nay</h6>
                            <h4 class="text-primary">@Model.TodayOrders</h4>
                            <small class="text-success"><i class="fas fa-arrow-up"></i> +8% so với hôm qua</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h6 class="text-muted">Khách hàng mới</h6>
                                                         <h4 class="text-info">@(Math.Round(Model.TotalUsers * 0.05))</h4>
                            <small class="text-warning"><i class="fas fa-minus"></i> -2% so với hôm qua</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h6 class="text-muted">Tỷ lệ chuyển đổi</h6>
                            <h4 class="text-warning">3.2%</h4>
                            <small class="text-success"><i class="fas fa-arrow-up"></i> +0.3% so với hôm qua</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts and Tables -->
<div class="row">
    <!-- Revenue Chart -->
    <div class="col-lg-8 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="admin-card-title">Doanh thu 7 ngày qua</h5>
                <small class="text-muted">Tổng: @Model.TotalRevenue.ToString("N0") VNĐ</small>
            </div>
            <div class="admin-card-body">
                <canvas id="revenueChart" style="height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Order Status Chart -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Trạng thái đơn hàng</h5>
            </div>
            <div class="admin-card-body">
                <canvas id="orderStatusChart" style="height: 300px;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Recent Orders -->
    <div class="col-lg-8 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="admin-card-title">Đơn hàng gần đây</h5>
                <a href="/Admin/Order" class="admin-btn admin-btn-primary admin-btn-sm">
                    <i class="fas fa-eye me-1"></i> Xem tất cả
                </a>
            </div>
            <div class="admin-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* TODO: Thay thế bằng dữ liệu thật từ database *@
                            <tr>
                                <td><strong>#@(1000 + Model.TotalOrders)</strong></td>
                                <td>@(Model.TotalUsers > 0 ? "Khách hàng " + (Model.TotalUsers % 100).ToString("D3") : "Khách vãng lai")</td>
                                <td class="format-currency">@((125000 + (Model.TotalOrders * 1234) % 50000).ToString())</td>
                                <td><span class="badge bg-warning">Chờ xử lý</span></td>
                                <td>@DateTime.Now.ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td><strong>#@(999 + Model.TotalOrders)</strong></td>
                                <td>@(Model.TotalUsers > 1 ? "Khách hàng " + ((Model.TotalUsers - 1) % 100).ToString("D3") : "Khách vãng lai")</td>
                                <td class="format-currency">@((89000 + (Model.TotalOrders * 987) % 30000).ToString())</td>
                                <td><span class="badge bg-success">Hoàn thành</span></td>
                                <td>@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")</td>
                            </tr>
                            <tr>
                                <td><strong>#@(998 + Model.TotalOrders)</strong></td>
                                <td>@(Model.TotalUsers > 2 ? "Khách hàng " + ((Model.TotalUsers - 2) % 100).ToString("D3") : "Khách vãng lai")</td>
                                <td class="format-currency">@((156000 + (Model.TotalOrders * 765) % 40000).ToString())</td>
                                <td><span class="badge bg-info">Đang giao</span></td>
                                <td>@DateTime.Now.AddDays(-1).ToString("dd/MM/yyyy")</td>
                            </tr>
                            @if (Model.TotalOrders == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                                        <br>Chưa có đơn hàng nào
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thao tác nhanh</h5>
            </div>
            <div class="admin-card-body">
                <div class="d-grid gap-2">
                    <a href="/Admin/Product/Create" class="admin-btn admin-btn-success">
                        <i class="fas fa-plus me-2"></i> Thêm sản phẩm mới
                    </a>
                    <a href="/Admin/Category/Create" class="admin-btn admin-btn-primary">
                        <i class="fas fa-tags me-2"></i> Thêm danh mục
                    </a>
                    <a href="/Admin/Store/Create" class="admin-btn admin-btn-warning">
                        <i class="fas fa-store me-2"></i> Thêm cửa hàng
                    </a>
                    <a href="/Admin/Order?status=0" class="admin-btn admin-btn-danger">
                        <i class="fas fa-clock me-2"></i> Xem đơn chờ xử lý
                    </a>
                    <hr class="my-3">
                    <h6 class="text-muted mb-2">Báo cáo</h6>
                    <a href="/Admin/Report" class="admin-btn admin-btn-info">
                        <i class="fas fa-chart-line me-2"></i> Báo cáo doanh thu
                    </a>
                    <a href="/Admin/Report/BestSelling" class="admin-btn admin-btn-secondary">
                        <i class="fas fa-trophy me-2"></i> Sản phẩm bán chạy
                    </a>
                </div>
            </div>
        </div>

        <!-- System Info -->
        <div class="admin-card mt-4">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Thông tin hệ thống</h5>
            </div>
            <div class="admin-card-body">
                <div class="row text-center">
                    <div class="col-6">
                        <div class="border-end">
                            <h6 class="text-success">Hoạt động</h6>
                            <small class="text-muted">Trạng thái</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <h6 class="text-primary">v1.0.0</h6>
                        <small class="text-muted">Phiên bản</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Additional Widgets Row -->
<div class="row">
    <!-- Top Products -->
    <div class="col-lg-6 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="admin-card-title">Sản phẩm bán chạy</h5>
                <a href="/Admin/Report/BestSelling" class="admin-btn admin-btn-primary admin-btn-sm">
                    <i class="fas fa-trophy me-1"></i> Xem tất cả
                </a>
            </div>
            <div class="admin-card-body">
                @if (Model.TotalProducts > 0)
                {
                    <div class="list-group list-group-flush">
                        @for (int i = 1; i <= Math.Min(5, Model.TotalProducts); i++)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                                <div class="d-flex align-items-center">
                                    <div class="me-3">
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="fas fa-coffee text-muted"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-0">Sản phẩm #@(i.ToString("D3"))</h6>
                                        <small class="text-muted">@((50 + i * 12) % 100) đã bán</small>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge badge-@(i <= 3 ? "success" : "secondary")">Top @i</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="fas fa-box fa-2x mb-2"></i>
                        <br>Chưa có sản phẩm nào
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-lg-6 col-md-12 mb-4">
        <div class="admin-card">
            <div class="admin-card-header">
                <h5 class="admin-card-title">Hoạt động gần đây</h5>
            </div>
            <div class="admin-card-body">
                <div class="activity-feed">
                    <div class="activity-item">
                        <div class="activity-icon bg-success">
                            <i class="fas fa-plus"></i>
                        </div>
                        <div class="activity-content">
                            <h6 class="mb-1">Thêm sản phẩm mới</h6>
                            <small class="text-muted">@DateTime.Now.AddMinutes(-15).ToString("HH:mm")</small>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon bg-info">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <div class="activity-content">
                            <h6 class="mb-1">Đơn hàng mới #@(1000 + Model.TotalOrders)</h6>
                            <small class="text-muted">@DateTime.Now.AddMinutes(-32).ToString("HH:mm")</small>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon bg-warning">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="activity-content">
                            <h6 class="mb-1">Khách hàng mới đăng ký</h6>
                            <small class="text-muted">@DateTime.Now.AddHours(-1).ToString("HH:mm")</small>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon bg-primary">
                            <i class="fas fa-cog"></i>
                        </div>
                        <div class="activity-content">
                            <h6 class="mb-1">Cập nhật hệ thống</h6>
                            <small class="text-muted">@DateTime.Now.AddHours(-3).ToString("HH:mm")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<!-- Leaflet CSS and JS for Map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
$(document).ready(function() {
    // Format numbers with thousand separators
    $('.format-number').each(function() {
        const value = $(this).text();
        $(this).text(parseInt(value).toLocaleString('vi-VN'));
    });

    // Format currency
    $('.format-currency').each(function() {
        const value = $(this).text();
        $(this).text(parseInt(value).toLocaleString('vi-VN') + ' ₫');
    });

    // Revenue Chart with dynamic data
    const revenueCtx = document.getElementById('revenueChart').getContext('2d');
    const revenueData = [@(Model.TotalRevenue * 0.1m), @(Model.TotalRevenue * 0.15m), @(Model.TotalRevenue * 0.08m), @(Model.TotalRevenue * 0.12m), @(Model.TotalRevenue * 0.18m), @(Model.TotalRevenue * 0.14m), @(Model.TotalRevenue * 0.16m)];
    
    new Chart(revenueCtx, {
        type: 'line',
        data: {
            labels: ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'CN'],
            datasets: [{
                label: 'Doanh thu (VNĐ)',
                data: revenueData,
                borderColor: '#3498db',
                backgroundColor: 'rgba(52, 152, 219, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return value.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return 'Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                        }
                    }
                }
            }
        }
    });

    // Order Status Chart with real data
    const orderStatusCtx = document.getElementById('orderStatusChart').getContext('2d');
    const totalCompleted = Math.max(1, @Model.TotalOrders - @Model.PendingOrders);
    const preparing = Math.round(totalCompleted * 0.3);
    const shipping = Math.round(totalCompleted * 0.2);
    const completed = Math.round(totalCompleted * 0.45);
    const cancelled = Math.round(totalCompleted * 0.05);

    new Chart(orderStatusCtx, {
        type: 'doughnut',
        data: {
            labels: ['Chờ xử lý', 'Đang chuẩn bị', 'Đang giao', 'Hoàn thành', 'Đã hủy'],
            datasets: [{
                data: [@Model.PendingOrders, preparing, shipping, completed, cancelled],
                backgroundColor: [
                    '#f39c12',
                    '#3498db', 
                    '#9b59b6',
                    '#2ecc71',
                    '#e74c3c'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = ((context.parsed * 100) / total).toFixed(1);
                            return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                        }
                    }
                }
            }
        }
    });

    // Auto refresh every 5 minutes (for demo purposes, adjust as needed)
    setTimeout(function() {
        if (confirm('Dữ liệu đã cũ. Bạn có muốn làm mới trang?')) {
            location.reload();
        }
    }, 300000); // 5 minutes

    // Add smooth animations to stats cards
    $('.stats-card').each(function(index) {
        $(this).css('animation-delay', (index * 0.1) + 's');
        $(this).addClass('animate__animated animate__fadeInUp');
    });

    // Add click event to quick action buttons
    $('.admin-btn').on('click', function() {
        const $this = $(this);
        $this.addClass('loading');
        setTimeout(function() {
            $this.removeClass('loading');
        }, 1000);
    });

    // Initialize Store Map
    initializeStoreMap();
});

// Update last refresh time
setInterval(function() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('vi-VN', { 
        hour: '2-digit', 
        minute: '2-digit',
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
    });
    $('.text-end small').text('Cập nhật lúc: ' + timeString);
}, 60000); // Update every minute

// Store Map Initialization
function initializeStoreMap() {
    // Store data from server
    const stores = @Html.Raw(Json.Serialize(Model.Stores.Select(s => new {
        Id = s.Id,
        Name = s.Name,
        Address = s.Address,
        Latitude = s.Latitude,
        Longitude = s.Longitude,
        PhoneNumber = s.PhoneNumber,
        OpeningHours = s.OpeningHours,
        City = s.City,
        District = s.District,
        Region = s.Region
    })));

    if (stores.length === 0) {
        $('#storeMap').html('<div class="text-center text-muted py-5"><i class="fas fa-store fa-3x mb-3"></i><br>Chưa có cửa hàng nào</div>');
        return;
    }

    // Calculate center point (Vietnam center as default)
    let centerLat = 16.0583;
    let centerLng = 108.2772;
    
    if (stores.length > 0) {
        centerLat = stores.reduce((sum, store) => sum + store.Latitude, 0) / stores.length;
        centerLng = stores.reduce((sum, store) => sum + store.Longitude, 0) / stores.length;
    }

    // Initialize map
    const map = L.map('storeMap').setView([centerLat, centerLng], 6);

    // Add tile layer (OpenStreetMap)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors',
        maxZoom: 18
    }).addTo(map);

    // Custom icons for different regions
    const northIcon = L.divIcon({
        html: '<i class="fas fa-map-marker-alt" style="color: #3498db; font-size: 24px;"></i>',
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30],
        className: 'custom-marker-icon'
    });

    const southIcon = L.divIcon({
        html: '<i class="fas fa-map-marker-alt" style="color: #e74c3c; font-size: 24px;"></i>',
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30],
        className: 'custom-marker-icon'
    });

    const defaultIcon = L.divIcon({
        html: '<i class="fas fa-map-marker-alt" style="color: #2ecc71; font-size: 24px;"></i>',
        iconSize: [30, 30],
        iconAnchor: [15, 30],
        popupAnchor: [0, -30],
        className: 'custom-marker-icon'
    });

    // Add markers for each store
    stores.forEach(store => {
        let icon = defaultIcon;
        if (store.Region === 'MB') icon = northIcon;
        else if (store.Region === 'MN') icon = southIcon;

        const marker = L.marker([store.Latitude, store.Longitude], { icon: icon })
            .addTo(map);

        // Create popup content
        const popupContent = `
            <div class="store-popup">
                <h6 class="mb-2"><i class="fas fa-store me-1"></i>${store.Name}</h6>
                <p class="mb-1"><i class="fas fa-map-marker-alt me-1"></i><small>${store.Address}</small></p>
                ${store.PhoneNumber ? `<p class="mb-1"><i class="fas fa-phone me-1"></i><small>${store.PhoneNumber}</small></p>` : ''}
                ${store.OpeningHours ? `<p class="mb-1"><i class="fas fa-clock me-1"></i><small>${store.OpeningHours}</small></p>` : ''}
                <div class="mt-2">
                    <a href="/Admin/Store/Details/${store.Id}" class="btn btn-sm btn-primary">
                        <i class="fas fa-eye me-1"></i>Chi tiết
                    </a>
                    <a href="/Admin/Store/Edit/${store.Id}" class="btn btn-sm btn-warning">
                        <i class="fas fa-edit me-1"></i>Sửa
                    </a>
                </div>
            </div>
        `;

        marker.bindPopup(popupContent);

        // Add hover effect
        marker.on('mouseover', function() {
            this.openPopup();
        });
    });

    // Fit map to show all markers
    if (stores.length > 0) {
        const group = L.featureGroup(map._layers);
        map.fitBounds(group.getBounds().pad(0.1));
    }
}
</script>

