@model IEnumerable<App.Areas.Admin.Controllers.UserViewModel>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-users"></i>
                        Quản lý người dùng
                    </h3>
                </div>
                <div class="card-body">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Search Form -->
                    <form method="get" class="mb-3">
                        <div class="row">
                            <div class="col-md-10">
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm người dùng..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Users Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Tên đăng nhập</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th>Quyền</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var userViewModel in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@userViewModel.User.UserName</strong>
                                            </td>
                                            <td>
                                                @userViewModel.User.Email
                                                @if (userViewModel.User.EmailConfirmed)
                                                {
                                                    <i class="fas fa-check-circle text-success" title="Email đã xác thực"></i>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-exclamation-circle text-warning" title="Email chưa xác thực"></i>
                                                }
                                            </td>
                                            <td>
                                                @userViewModel.User.PhoneNumber
                                                @if (userViewModel.User.PhoneNumberConfirmed)
                                                {
                                                    <i class="fas fa-check-circle text-success" title="SĐT đã xác thực"></i>
                                                }
                                            </td>
                                            <td>
                                                @if (userViewModel.Roles.Any())
                                                {
                                                    @foreach (var role in userViewModel.Roles)
                                                    {
                                                        <span class="badge badge-@(role == "Administrator" ? "danger" : role == "Editor" ? "warning" : "info")">@role</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">User</span>
                                                }
                                            </td>
                                            <td>
                                                @if (userViewModel.User.LockoutEnd.HasValue && userViewModel.User.LockoutEnd > DateTime.UtcNow)
                                                {
                                                    <span class="badge badge-danger">Bị khóa</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">Hoạt động</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = userViewModel.User.Id })" class="btn btn-sm btn-info" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("ManageRoles", new { id = userViewModel.User.Id })" class="btn btn-sm btn-warning" title="Quản lý quyền">
                                                        <i class="fas fa-user-cog"></i>
                                                    </a>
                                                    <form method="post" action="@Url.Action("LockUnlock", new { id = userViewModel.User.Id })" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        @if (userViewModel.User.LockoutEnd.HasValue && userViewModel.User.LockoutEnd > DateTime.UtcNow)
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-success" title="Mở khóa">
                                                                <i class="fas fa-unlock"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-sm btn-danger" title="Khóa tài khoản">
                                                                <i class="fas fa-lock"></i>
                                                            </button>
                                                        }
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            <em>Chưa có người dùng nào</em>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                    <!-- Summary -->
                    @if (ViewBag.TotalItems != null)
                    {
                        <div class="mt-3">
                            <small class="text-muted">
                                Tổng cộng: <strong>@ViewBag.TotalItems</strong> người dùng
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 