@model IEnumerable<App.Models.Toocha.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-shopping-cart"></i>
                        Quản lý đơn hàng
                    </h3>
                </div>
                <div class="card-body">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Search and Filter Form -->
                    <form method="get" class="mb-3">
                        <div class="row">
                            <div class="col-md-3">
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm đơn hàng..." />
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-control">
                                    <option value="">Tất cả trạng thái</option>
                                    @if (ViewBag.OrderStatuses != null)
                                    {
                                        @foreach (var statusOption in ViewBag.OrderStatuses)
                                        {
                                            <option value="@statusOption.Value" selected="@(statusOption.Selected)">@statusOption.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="fromDate" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <input type="date" name="toDate" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Orders Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Khách hàng</th>
                                    <th>Số điện thoại</th>
                                    <th>Ngày đặt</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thanh toán</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@order.Id</strong>
                                            </td>
                                            <td>
                                                @if (order.User != null)
                                                {
                                                    @order.User.UserName
                                                }
                                                else
                                                {
                                                    <em>Khách vãng lai</em>
                                                }
                                            </td>
                                            <td>@order.PhoneNumber</td>
                                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <strong class="text-success">@order.TotalPrice.ToString("N0") VNĐ</strong>
                                            </td>
                                            <td>
                                                <span class="badge badge-@(order.Status == App.Models.Toocha.OrderStatus.Delivered ? "success" : 
                                                    order.Status == App.Models.Toocha.OrderStatus.Cancelled ? "danger" : 
                                                    order.Status == App.Models.Toocha.OrderStatus.Processing ? "warning" : "secondary")">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (order.IsPaid)
                                                {
                                                    <span class="badge badge-success">Đã thanh toán</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-warning">Chưa thanh toán</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = order.Id })" class="btn btn-sm btn-info" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = order.Id })" class="btn btn-sm btn-warning" title="Sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    @if (!order.IsPaid)
                                                    {
                                                        <form method="post" action="@Url.Action("TogglePayment", new { id = order.Id })" style="display: inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-sm btn-success" title="Đánh dấu đã thanh toán">
                                                                <i class="fas fa-money-bill"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <em>Chưa có đơn hàng nào</em>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search, status = ViewBag.Status, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 