@model IEnumerable<App.Models.Toocha.Store>

@{
    ViewData["Title"] = "Quản lý cửa hàng";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-store"></i>
                        Quản lý cửa hàng
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Create")" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Thêm cửa hàng mới
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            @TempData["StatusMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Search Form -->
                    <form method="get" class="mb-3">
                        <div class="row">
                            <div class="col-md-10">
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm kiếm cửa hàng..." />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-search"></i> Tìm kiếm
                                </button>
                            </div>
                        </div>
                    </form>

                    <!-- Stores Table -->
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Tên cửa hàng</th>
                                    <th>Địa chỉ</th>
                                    <th>Thành phố</th>
                                    <th>Số điện thoại</th>
                                    <th>Giờ mở cửa</th>
                                    <th>Trạng thái</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var store in Model)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@store.Name</strong>
                                            </td>
                                            <td>@store.Address</td>
                                            <td>
                                                <span class="badge badge-info">@store.City</span>
                                                @if (!string.IsNullOrEmpty(store.District))
                                                {
                                                    <br><small class="text-muted">@store.District</small>
                                                }
                                            </td>
                                            <td>@store.PhoneNumber</td>
                                            <td>
                                                <small class="text-muted">@store.OpeningHours</small>
                                            </td>
                                            <td>
                                                @if (store.IsActive)
                                                {
                                                    <span class="badge badge-success">Hoạt động</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">Tạm ngưng</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Details", new { id = store.Id })" class="btn btn-sm btn-info" title="Xem chi tiết">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = store.Id })" class="btn btn-sm btn-warning" title="Sửa">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <form method="post" action="@Url.Action("ToggleActive", new { id = store.Id })" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm @(store.IsActive ? "btn-secondary" : "btn-success")" 
                                                                title="@(store.IsActive ? "Tạm ngưng" : "Kích hoạt")">
                                                            <i class="fas @(store.IsActive ? "fa-pause" : "fa-play")"></i>
                                                        </button>
                                                    </form>
                                                    <a href="@Url.Action("Delete", new { id = store.Id })" class="btn btn-sm btn-danger" title="Xóa">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <em>Chưa có cửa hàng nào</em>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { page = i, search = ViewBag.Search })">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                    <!-- Summary -->
                    @if (ViewBag.TotalItems != null)
                    {
                        <div class="mt-3">
                            <small class="text-muted">
                                Tổng cộng: <strong>@ViewBag.TotalItems</strong> cửa hàng
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 