@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Quản lý Khuyến mãi</h2>
        <p class="text-muted mb-0">Tổng quan về các chương trình khuyến mãi</p>
    </div>
    <div>
        <a href="/Admin/Promotion/Create" class="admin-btn admin-btn-success">
            <i class="fas fa-plus me-2"></i>Tạo khuyến mãi mới
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Danh sách khuyến mãi</h5>
    </div>
    <div class="admin-card-body">
        <div class="text-center text-muted py-5">
            <i class="fas fa-percentage fa-3x mb-3"></i>
            <h5>Chưa có khuyến mãi nào</h5>
            <p>Tạo chương trình khuyến mãi đầu tiên để thu hút khách hàng</p>
            <a href="/Admin/Promotion/Create" class="admin-btn admin-btn-primary">
                <i class="fas fa-plus me-2"></i>Tạo khuyến mãi mới
            </a>
        </div>
    </div>
</div>
