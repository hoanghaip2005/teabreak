@{
    ViewData["Title"] = "Tạo khuyến mãi mới";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Tạo khuyến mãi mới</h2>
        <p class="text-muted mb-0">Tạo chương trình khuyến mãi để thu hút khách hàng</p>
    </div>
    <div>
        <a href="/Admin/Promotion" class="admin-btn admin-btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <h5 class="admin-card-title">Thông tin khuyến mãi</h5>
    </div>
    <div class="admin-card-body">
        <form>
            <div class="mb-3">
                <label for="promotionName" class="form-label">Tên khuyến mãi <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="promotionName" placeholder="VD: Sale mùa hè 2024">
            </div>
            
            <div class="mb-3">
                <label for="description" class="form-label">Mô tả</label>
                <textarea class="form-control" id="description" rows="3" placeholder="Mô tả chi tiết về chương trình khuyến mãi"></textarea>
            </div>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="discountType" class="form-label">Loại giảm <span class="text-danger">*</span></label>
                    <select class="form-select" id="discountType">
                        <option value="percentage">Giảm theo %</option>
                        <option value="fixed">Giảm số tiền cố định</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="discountValue" class="form-label">Giá trị giảm <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="discountValue" placeholder="20">
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <button type="submit" class="admin-btn admin-btn-success">
                    <i class="fas fa-save me-2"></i>Lưu khuyến mãi
                </button>
                <a href="/Admin/Promotion" class="admin-btn admin-btn-secondary">
                    <i class="fas fa-times me-2"></i>Hủy
                </a>
            </div>
        </form>
    </div>
</div>
