@startuml Toocha_Complete_UseCase_Diagram
!theme plain
skinparam usecase {
    BackgroundColor lightcyan
    BorderColor darkblue
    FontSize 10
}
skinparam actor {
    BackgroundColor lightgreen
    BorderColor darkgreen
    FontSize 11
}
skinparam rectangle {
    BackgroundColor lightyellow
    BorderColor orange
    FontSize 9
}

